---
export const prerender = true;
import { Button } from "@/components/ui/button";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import {
  IconBuildingSkyscraper,
  IconSearch,
  IconTarget,
  IconHeartHandshake,
  IconCheck,
  IconExternalLink,
  IconChevronRight,
  IconArrowRight,
  IconBrandFigma,
  IconPalette,
  IconSeo,
  IconBook,
  IconMovie,
  IconWallpaper
} from "@tabler/icons-react";

const meta = {
  title: "Case Study | Astra Design Bureau",
  description:
    "A strategic branding and digital design bureau that creates sustainable, long-lasting design solutions for businesses.",
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    
      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
    <link rel="stylesheet" href="/src/styles/globals.css" />
  </head>

  <body class="bg-white dark:bg-black">
    <FloatingDockDemo client:load />

    <!-- Hero section with overlapping elements -->
    <header class="relative pt-20 pb-0 bg-gradient-to-br from-neutral-50 to-neutral-100 dark:from-neutral-950 dark:to-neutral-900 overflow-hidden">
      <div class="mx-auto max-w-7xl px-6">
        <a href="/" class="inline-flex items-center gap-2 mb-8 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back
        </a>

        <!-- Project metadata row -->
        <div class="flex flex-wrap gap-6 mb-6 text-sm">
          <div class="inline-block px-3 py-1 font-medium tracking-wider rounded-full bg-neutral-200 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
            Brand Design
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Authors:</span>
            <span class="text-neutral-800 dark:text-neutral-200">Henrietta, Nestors & Imran</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Year:</span>
            <span class="text-neutral-800 dark:text-neutral-200">2023-2024</span>
          </div>
        </div>

        <!-- Main heading with visual interest -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="relative z-10">
            <div class="absolute -left-10 -top-10 w-32 h-32 bg-neutral-100 dark:bg-neutral-900 rounded-full opacity-50 blur-2xl"></div>
            <h1 class="relative text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-neutral-800 dark:text-neutral-100 mb-6">
              Astra Design Bureau — A Sustainable Approach
            </h1>
            <p class="text-lg md:text-xl text-neutral-700 dark:text-neutral-300 max-w-xl mb-10">
              Creating a unique design bureau brand that focuses on long-term sustainability and strong client partnerships in a market dominated by short-term project thinking.
            </p>
            
            <!-- Key outcomes in a horizontal list -->
            <div class="flex flex-wrap gap-4 mb-10">
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Brand Identity
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Strategic Positioning
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                SEO Strategy
              </div>
            </div>
          </div>
          
          <div class="relative">
            <div class="absolute -right-40 -bottom-20 w-80 h-80 bg-neutral-200 dark:bg-neutral-800 rounded-full opacity-30 blur-3xl"></div>
            <div class="absolute right-20 top-10 w-32 h-32 bg-neutral-200 dark:bg-neutral-900 rounded-full opacity-30 blur-xl"></div>
            <div class="w-full rounded-xl overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
              <img 
                src="/photos/projects/Astra/1.jpg" 
                alt="Astra Design Bureau hero image" 
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="flex justify-center mt-8 mb-4">
          <a href="#content" class="animate-bounce p-2 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm shadow-sm">
            <IconChevronRight className="w-5 h-5 text-neutral-500 dark:text-neutral-400 rotate-90" />
          </a>
        </div>
      </div>
    </header>

    <main id="content" class="py-24 bg-white dark:bg-black">
      <div class="mx-auto max-w-7xl px-6">
        <!-- Challenge and Solution in a card-based layout -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
          <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Problem Background</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              In the current market situation, finding a reliable digital design bureau as a long-term sustainable partner is extremely difficult. Design bureaus tend to work project-to-project, focusing on short campaigns and bold statements. This creates an unsustainable environment that often leaves many projects and materials unfinished after the contract period ends. Additionally, businesses don't always understand the benefits of long-term sustainable design and digital practices, despite the potentially high cost of short-term thinking in today's era.
            </p>
          </div>

          <div class="bg-neutral-50 dark:bg-neutral-950 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Our Solution</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              Creating a design bureau brand called Astra that stands out through its commitment to long-term partnerships and sustainable design practices. By focusing on building ongoing relationships with clients rather than one-off projects, Astra aims to deliver more value and consistent results. The brand combines mid-century and modern futuristic design elements inspired by space themes, projecting both ambition and sophistication.
            </p>
          </div>
        </div>

        <!-- SWOT Analysis section -->
        <section class="mb-24 bg-gradient-to-br from-neutral-50 to-neutral-100 dark:from-neutral-900 dark:to-neutral-950 p-8 md:p-12 rounded-3xl relative overflow-hidden">
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-neutral-200 dark:bg-neutral-800 rounded-full opacity-20 blur-3xl"></div>
          
          <h2 class="text-2xl md:text-3xl font-bold mb-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 relative z-10">
            <IconBuildingSkyscraper className="w-8 h-8 text-neutral-500" />
            <span>SWOT Analysis</span>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
            <div>
              <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Strengths</h3>
              <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Creative and technological expertise with focus on sustainable approaches</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Deep understanding of both Danish and international markets</span>
                </li>
              </ul>
              
              <h3 class="text-xl font-bold mb-4 mt-8 text-neutral-800 dark:text-neutral-100">Weaknesses</h3>
              <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Challenges with market share and brand recognition as a new player</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Resource limitations that may hinder scalability and growth</span>
                </li>
              </ul>
            </div>
            
            <div>
              <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Opportunities</h3>
              <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Growing demand for digitalization and sustainable solutions</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Potential for international expansion leveraging Denmark's reputation</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Training staff in brand alignment</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Subscription model for longer-term collaborations</span>
                </li>
              </ul>
              
              <h3 class="text-xl font-bold mb-4 mt-8 text-neutral-800 dark:text-neutral-100">Threats</h3>
              <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Strong competition in the design agency market</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Highly unpredictable effects of constant technological changes</span>
                </li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Target Markets section -->
        <section class="mb-24">
          <h2 class="text-2xl md:text-3xl font-bold mb-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100">
            <IconTarget className="w-8 h-8 text-neutral-500" />
            <span>Target Markets</span>
          </h2>
          
          <p class="text-neutral-600 dark:text-neutral-400 mb-8 max-w-3xl">
            Astra focuses on medium to large businesses and technology-oriented startups, particularly those with a strong commitment to sustainable digital growth. These businesses seek not only to improve their online presence but also to ensure their growth is sustainable and responsible.
          </p>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm">
              <h3 class="font-bold text-lg mb-4 text-neutral-800 dark:text-neutral-100">Technology Sectors</h3>
              <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Technology</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Renewable Energy</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Clean Transportation</span>
                </li>
              </ul>
            </div>
            
            <div class="bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm">
              <h3 class="font-bold text-lg mb-4 text-neutral-800 dark:text-neutral-100">Sustainable Industries</h3>
              <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Environmental Services</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Sustainable Agriculture</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Eco-friendly Consumer Goods</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Circular Economy</span>
                </li>
              </ul>
            </div>
            
            <div class="bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm">
              <h3 class="font-bold text-lg mb-4 text-neutral-800 dark:text-neutral-100">Other Key Sectors</h3>
              <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Architecture</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Sustainable Tourism</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Green Finance</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Real Estate</span>
                </li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Brand Identity section -->
        <section class="mb-24 bg-neutral-50 dark:bg-neutral-900 p-8 md:p-12 rounded-3xl relative overflow-hidden">
          <div class="absolute -left-20 -top-20 w-80 h-80 bg-neutral-200 dark:bg-neutral-800 rounded-full opacity-20 blur-3xl"></div>
          
          <h2 class="text-2xl md:text-3xl font-bold mb-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 relative z-10">
            <IconPalette className="w-8 h-8 text-neutral-500" />
            <span>Brand Identity</span>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-10 relative z-10">
            <div>
              <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Design Philosophy</h3>
              <p class="text-neutral-600 dark:text-neutral-400 mb-6">
                The Astra brand embodies a fusion of mid-century and modern futuristic design, drawing inspiration from space themes (specifically the NASA Graphics Standards Manual), early 20th century avant-garde design, and the work of construction bureaus.
              </p>
              <p class="text-neutral-600 dark:text-neutral-400">
                This fusion is realized through the adoption of design philosophies and techniques
                reminiscent of that era, including the choice of iconic grotesque fonts from the 20th
                century, such as Helvetica and Futura PT.
              </p>
            </div>
            
            <div>
              <h3 class="text-lg font-bold mb-4 text-neutral-800 dark:text-neutral-100">Brand Elements</h3>
              <div class="space-y-6">
                <div>
                  <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-2">Name & Concept</div>
                  <p class="text-neutral-700 dark:text-neutral-300">
                    The brand's identity is defined by its nomenclature, where the choice of "bureau" over "studio" evokes a sense of structure, exclusivity, and distinction, underscoring its alignment with the ethos of industrial and engineering design from historical construction bureaus known for their extraordinary products and designs. The cosmic and sophisticated theme continues to be a cornerstone of the brand's
                    identity, encapsulated in its Latin motto and name, which underscore its ambition and
                    sophistication within the cosmic theme.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Brandbook Elements section -->
        <section class="mb-24">
          <div class="flex items-center mb-12">
            <div class="h-px bg-neutral-200 dark:bg-neutral-800 flex-grow"></div>
            <h2 class="text-2xl md:text-3xl font-bold px-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 whitespace-nowrap">
              <IconBook className="w-8 h-8 text-neutral-500" />
              <span>Brandbook Elements</span>
            </h2>
            <div class="h-px bg-neutral-200 dark:bg-neutral-800 flex-grow"></div>
          </div>
          
          <!-- Logo section -->
          <div class="mb-16">
            <h3 class="text-xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Logo</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="bg-white dark:bg-neutral-950 p-8 rounded-xl flex items-center justify-center">
                <img 
                  src="/photos/projects/Astra/Logotype-1.webp" 
                  alt="Astra logo" 
                  class="max-w-full h-auto max-h-48"
                />
              </div>
              <div class="rounded-xl flex items-center justify-center">
                <img 
                  src="/photos/projects/Astra/Logotype.webp" 
                  alt="Astra logo rules" 
                  class="max-w-full h-auto max-h-48"
                />
              </div>
              <div class="md:col-span-2 mt-4">
                <p class="text-neutral-600 dark:text-neutral-400">
                  The Astra logo combines geometric precision with space-inspired elements, creating a mark that's both modern and timeless. It's designed for versatility across digital and print applications while maintaining strong recognition at various sizes.
                </p>
              </div>
            </div>
          </div>
          
          <!-- Typography section -->
          <div class="my-16">
            <h3 class="text-xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Typography</h3>
            <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-xl">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                  <h4 class="text-lg font-medium mb-4 text-neutral-800 dark:text-neutral-200">Primary Font</h4>
                  <div class="space-y-4">
                    <div class="font-sans text-4xl text-neutral-800 dark:text-neutral-100">Aa Bb Cc</div>
                    <div class="font-sans text-2xl text-neutral-700 dark:text-neutral-200">0123456789</div>
                    <p class="font-sans text-neutral-600 dark:text-neutral-400 mt-2">
                      Primary sans-serif typeface for headers and UI elements
                    </p>
                  </div>
                </div>
                <div>
                  <h4 class="text-lg font-medium mb-4 text-neutral-800 dark:text-neutral-200">Secondary Font</h4>
                  <div class="space-y-4">
                    <div class="font-serif text-4xl text-neutral-800 dark:text-neutral-100">Aa Bb Cc</div>
                    <div class="font-serif text-2xl text-neutral-700 dark:text-neutral-200">0123456789</div>
                    <p class="font-serif text-neutral-600 dark:text-neutral-400 mt-2">
                      Secondary serif typeface for body text and longer passages
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Color Palette section -->
          <div class="my-16">
            <h3 class="text-xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Color Palette</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
              <div class="flex flex-col items-center">
                <div class="h-24 w-24 rounded-xl bg-neutral-900 shadow-md"></div>
                <span class="mt-2 text-sm font-mono text-neutral-700 dark:text-neutral-300">#111111</span>
                <span class="text-xs text-neutral-500">Primary Black</span>
              </div>
              <div class="flex flex-col items-center">
                <div class="h-24 w-24 rounded-xl shadow-md" style="background-color: #EEEEEE"></div>
                <span class="mt-2 text-sm font-mono text-neutral-700 dark:text-neutral-300">#EEEEEE</span>
                <span class="text-xs text-neutral-500">Off White</span>
              </div>
              <div class="flex flex-col items-center">
                <div class="h-24 w-24 rounded-xl shadow-md" style="background-color: #FFFFFF"></div>
                <span class="mt-2 text-sm font-mono text-neutral-700 dark:text-neutral-300">#FFFFFF</span>
                <span class="text-xs text-neutral-500">White</span>
              </div>
              <div class="flex flex-col items-center">
                <div class="h-24 w-24 rounded-xl shadow-md" style="background-color: #999999"></div>
                <span class="mt-2 text-sm font-mono text-neutral-700 dark:text-neutral-300">#999999</span>
                <span class="text-xs text-neutral-500">Light Gray</span>
              </div>
              <div class="flex flex-col items-center">
                <div class="h-24 w-24 rounded-xl shadow-md" style="background-color: #333"></div>
                <span class="mt-2 text-sm font-mono text-neutral-700 dark:text-neutral-300">#333333</span>
                <span class="text-xs text-neutral-500">Dark Gray</span>
              </div>
            </div>
          </div>
          
          <!-- Photography section -->
          <div class="mb-16">
            <h3 class="text-xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Photography Style</h3>
            <div class="">
              <img 
                src="/photos/projects/Astra/Images&Photography.webp" 
                alt="Astra photography style example 1" 
                class="w-full h-auto object-cover rounded-xl"
              />
            </div>
            <p class="mt-6 text-neutral-600 dark:text-neutral-400">
              The photography style emphasizes clean lines, geometric compositions, and a carefully controlled color palette that complements the brand's core colors. Images feature a mix of abstract patterns, architectural elements, and minimalist workspaces that reflect the brand's technical yet sophisticated aesthetic.
            </p>
          </div>
          
          <!-- Brand Vision -->
          <div>
            <h3 class="text-xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Brand Vision</h3>
            <div class="bg-gradient-to-br from-neutral-100 to-white dark:from-neutral-900 dark:to-neutral-800 p-8 rounded-xl">
              <div class="text-center">
                <p class="text-xl md:text-2xl mx-auto max-w-3xl font-serif italic text-neutral-800 dark:text-neutral-100 mb-6">
                  "Let us navigate the space of tradition and tomorrow, creating a digital presence
                  that is not only seen but felt and remembered."
                </p>
                <p class="text-neutral-600 leading-relaxed dark:text-neutral-400">
                  At Astra, we stand at the crossroads of time, blending the accuracy of modern design with the
                  boundless possibilities of the future. Our roots are deeply embedded in the historic philosophies
                  of design, while our name, "bureau," reflects our commitment to excellence, structure, and
                  exclusivity. Our agency is propelled by drive for innovation, a commitment to practical solutions,
                  and a respect for time-honored principles. Our differentiation lies in our ability to transform your
                  online presence. Through innovative design, strategic branding, and targeted SEO, we don't just
                  promise visibility; we guarantee meaningful growth.

                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Value Proposition section -->
        <section class="mb-24">
          <div class="flex items-center mb-12">
            <div class="h-px bg-neutral-200 dark:bg-neutral-800 flex-grow"></div>
            <h2 class="text-2xl md:text-3xl font-bold px-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 whitespace-nowrap">
              <IconHeartHandshake className="w-8 h-8 text-neutral-500" />
              <span>Value Proposition</span>
            </h2>
            <div class="h-px bg-neutral-200 dark:bg-neutral-800 flex-grow"></div>
          </div>
          
          <div class="">
            <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed mb-10">
              Astra is dedicated to transforming your company's online presence through innovative design, strategic branding, and targeted SEO. As your partner in digital transformation, we create solutions that forge strong connections between your business and your audience—solutions that speak directly to the heart of your customers' needs.
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm">

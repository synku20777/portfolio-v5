---
import SiteShell from "@/components/SiteShell.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getReadingTime } from "@/lib/reading-time";
import { siteConfig } from "@/lib/site";

type BlogPost = CollectionEntry<"blog">;

interface Props {
  tag: string;
  posts: BlogPost[];
}

export async function getStaticPaths() {
  const posts: BlogPost[] = await getCollection("blog");
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .filter((post) => !post.data.draft || !import.meta.env.PROD)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props as Props;
const title = `${tag} notes | Nest`;
const description = `All notes tagged with "${tag}".`;
const tagSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: `${siteConfig.siteUrl}/blog/tag/${encodeURIComponent(tag)}`,
};
---

<SiteShell title={title} description={description} schema={tagSchema} mainClass="bg-white pb-20 pt-8 dark:bg-black sm:pt-12">
  <div class="mx-auto max-w-7xl px-6">
    <a href="/blog" class="group mb-10 inline-flex min-h-11 items-center gap-2 rounded-full border border-neutral-400 px-4 text-sm font-medium text-neutral-700 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:text-neutral-200 dark:hover:bg-neutral-900 dark:focus-visible:outline-sky-400 sm:mb-14">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="motion-safe:transition-transform motion-safe:group-hover:-translate-x-1"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
      All notes
    </a>
    <header class="notes-reveal mb-10">
      <h1 class="max-w-[23ch] text-balance text-4xl font-semibold leading-tight tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-5xl lg:text-6xl">{tag} notes</h1>
      <p class="mt-6 text-base leading-relaxed text-neutral-600 dark:text-neutral-300">{posts.length} note{posts.length !== 1 ? "s" : ""}</p>
    </header>
      <div>
        {posts.map((post) => {
          const readingTime = getReadingTime(post.body ?? "");
          const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });
          return (
            <article>
              <a href={`/blog/${post.id}/`} class="group block border-t border-neutral-200 py-7 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:border-neutral-800 dark:focus-visible:outline-sky-400 md:py-9">
                {post.data.heroImage && (
                  <img src={post.data.heroImage} alt={post.data.title} loading="lazy" decoding="async" class="mb-6 h-40 w-full max-w-sm rounded-xl object-cover" />
                )}
                <div class="grid gap-x-10 gap-y-3 md:grid-cols-[9rem_minmax(0,1fr)]">
                  <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400 md:row-span-3 md:flex-col">
                    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                    <span>{readingTime}</span>
                  </div>
                  <h2 class="max-w-[36ch] text-balance text-xl font-semibold leading-tight tracking-tight text-neutral-900 underline-offset-4 group-hover:underline dark:text-neutral-100 sm:text-2xl">
                    {post.data.title}
                  </h2>
                  <p class="max-w-[60ch] text-sm leading-relaxed text-neutral-600 dark:text-neutral-300 md:col-start-2 sm:text-base">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400 md:col-start-2">
                      {post.data.tags.map((currentTag) => <span>{currentTag}</span>)}
                    </div>
                  )}
                </div>
              </a>
            </article>
          );
        })}
      </div>
  </div>
</SiteShell>

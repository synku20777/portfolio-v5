---
import SiteShell from "@/components/SiteShell.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getReadingTime } from "@/lib/reading-time";
import { siteConfig } from "@/lib/site";

type BlogPost = CollectionEntry<"blog">;

interface Props {
  tag: string;
  posts: BlogPost[];
}

export async function getStaticPaths() {
  const posts: BlogPost[] = await getCollection("blog");
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .filter((post) => !post.data.draft || !import.meta.env.PROD)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props as Props;
const title = `${tag} notes | Nest`;
const description = `All notes tagged with "${tag}".`;
const tagSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: `${siteConfig.siteUrl}/blog/tag/${encodeURIComponent(tag)}`,
};
---

<SiteShell title={title} description={description} schema={tagSchema} mainClass="pt-20 pb-16">
  <div class="mx-auto max-w-7xl px-6">
    <header class="mb-10">
      <a
        href="/blog"
        class="mb-4 inline-flex items-center gap-2 text-sm text-neutral-700 transition-colors hover:text-black dark:text-neutral-300 dark:hover:text-white"
      >
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="inline-block"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        All notes
      </a>
      <h1 class="text-xs font-semibold uppercase tracking-[0.35rem] text-neutral-400 dark:text-zinc-500">
        Tagged: {tag}
      </h1>
      <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">
        {posts.length} note{posts.length !== 1 ? "s" : ""}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => {
        const readingTime = getReadingTime(post.body ?? "");
        const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        });

        return (
          <a
            href={`/blog/${post.id}/`}
            class="group overflow-hidden rounded-lg bg-neutral-50 transition-colors hover:bg-neutral-100 dark:bg-zinc-900 dark:hover:bg-zinc-800"
          >
            {post.data.heroImage && (
              <div class="relative h-48 w-full overflow-hidden">
                <img
                  src={post.data.heroImage}
                  alt={post.data.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
            )}
            <div class="p-5">
              <div class="mb-3 flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                <span aria-hidden="true">&middot;</span>
                <span>{readingTime}</span>
              </div>
              <h2 class="text-lg font-semibold leading-tight text-stone-900 transition-colors group-hover:text-stone-700 dark:text-zinc-100 dark:group-hover:text-zinc-200">
                {post.data.title}
              </h2>
              <p class="mt-2 text-sm text-stone-600 dark:text-zinc-400">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {post.data.tags.map((currentTag) => (
                    <span
                      class:list={[
                        "inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-tighter",
                        currentTag === tag
                          ? "border-neutral-400 bg-neutral-200 text-stone-700 dark:border-zinc-500 dark:bg-zinc-700 dark:text-zinc-200"
                          : "border-neutral-200/80 bg-white text-stone-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300",
                      ]}
                    >
                      {currentTag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</SiteShell>

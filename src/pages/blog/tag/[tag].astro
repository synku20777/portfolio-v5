---
import BaseHead from "@/components/BaseHead.astro";
import "@/styles/globals.css";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import { getCollection, type CollectionEntry } from 'astro:content';
import { getReadingTime } from '@/lib/reading-time';

type BlogPost = CollectionEntry<'blog'>;

interface Props {
  tag: string;
  posts: BlogPost[];
}

export async function getStaticPaths() {
  const posts: BlogPost[] = await getCollection('blog');
  const tags = [...new Set(posts.flatMap(post => post.data.tags))];
  return tags.map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter(post => post.data.tags.includes(tag))
        .filter(post => !post.data.draft || !import.meta.env.PROD)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props as Props;
const title = `Posts tagged "${tag}" | Nest Blog`;
const description = `All blog posts tagged with "${tag}".`;
---

<html lang="en">
  <head>
    <BaseHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const setDarkClass = () => {
        const isDark = getThemePreference() === 'dark';
        document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
      };

      setDarkClass();
      document.addEventListener('astro:after-swap', setDarkClass);

      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
  </head>

  <body class="bg-white dark:bg-black antialiased selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <FloatingDockDemo client:load />

    <main class="pt-20 pb-16">
      <div class="mx-auto max-w-7xl px-6">
        <!-- Page header -->
        <div class="mb-10">
          <a href="/blog" class="inline-flex items-center gap-2 mb-4 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors text-sm">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
              <path d="m12 19-7-7 7-7"></path>
              <path d="M19 12H5"></path>
            </svg>
            All posts
          </a>
          <h1 class="text-xs font-semibold uppercase tracking-[0.35rem] text-neutral-400 dark:text-zinc-500">
            Tagged: {tag}
          </h1>
          <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">
            {posts.length} post{posts.length !== 1 ? 's' : ''}
          </p>
        </div>

        <!-- Post grid -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map(post => {
            const readingTime = getReadingTime(post.body ?? '');
            const formattedDate = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            return (
              <a
                href={`/blog/${post.id}`}
                class="group rounded-lg bg-neutral-50 dark:bg-zinc-900 hover:bg-neutral-100 dark:hover:bg-zinc-800 transition-colors overflow-hidden"
              >
                {post.data.heroImage && (
                  <div class="relative h-48 w-full overflow-hidden">
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class="p-5">
                  <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 mb-3">
                    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                    <span aria-hidden="true">·</span>
                    <span>{readingTime}</span>
                  </div>
                  <h2 class="text-lg font-semibold leading-tight text-stone-900 dark:text-zinc-100 group-hover:text-stone-700 dark:group-hover:text-zinc-200 transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-stone-600 dark:text-zinc-400 line-clamp-2">
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {post.data.tags.map(t => (
                        <span class:list={[
                          "inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-tighter",
                          t === tag
                            ? "border-neutral-400 bg-neutral-200 text-stone-700 dark:border-zinc-500 dark:bg-zinc-700 dark:text-zinc-200"
                            : "border-neutral-200/80 bg-white text-stone-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300"
                        ]}>
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </main>

    <Footer name="Nest" client:visible />
  </body>
</html>

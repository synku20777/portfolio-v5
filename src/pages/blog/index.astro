---
import SiteShell from "@/components/SiteShell.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getReadingTime } from "@/lib/reading-time";
import { siteConfig } from "@/lib/site";

type BlogPost = CollectionEntry<"blog">;

const allPosts: BlogPost[] = await getCollection("blog");
const posts = allPosts
  .filter((post) => !post.data.draft || !import.meta.env.PROD)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();

const title = "Notes | Nest";
const description =
  "Short essays and working notes on design systems, frontend craft, product decisions, and the occasional visual tangent.";

const notesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: `${siteConfig.siteUrl}/blog`,
};
---

<SiteShell title={title} description={description} schema={notesSchema} mainClass="pt-20 pb-16">
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Nest Notes" href="/rss.xml" />
  </Fragment>

  <div class="mx-auto max-w-7xl px-6">
    <header class="mb-10">
      <a
        id="blog-index-back-link"
        href="/"
        class="mb-8 inline-flex items-center gap-2 text-neutral-700 transition-colors hover:text-black dark:text-neutral-300 dark:hover:text-white"
      >
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="inline-block"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Home
      </a>
      <h1 class="text-xs font-semibold uppercase tracking-[0.35rem] text-neutral-400 dark:text-zinc-500">
        Notes
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
    </header>

    {allTags.length > 0 && (
      <div class="mb-8 flex flex-wrap gap-2">
        <a
          href="/blog"
          class="inline-flex items-center rounded-full border border-neutral-400 bg-neutral-200 px-3 py-1.5 text-xs font-semibold uppercase tracking-tighter text-stone-700 dark:border-zinc-500 dark:bg-zinc-700 dark:text-zinc-200"
        >
          All
        </a>
        {allTags.map((tag) => (
          <a
            href={`/blog/tag/${encodeURIComponent(tag)}`}
            class="inline-flex items-center rounded-full border border-neutral-200/80 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-tighter text-stone-500 transition-colors hover:bg-neutral-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700"
          >
            {tag}
          </a>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <p class="text-neutral-500 dark:text-neutral-400">No notes yet. Check back soon.</p>
    ) : (
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const readingTime = getReadingTime(post.body ?? "");
          const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });

          return (
            <a
              href={`/blog/${post.id}/`}
              class="group overflow-hidden rounded-lg bg-neutral-50 transition-colors hover:bg-neutral-100 dark:bg-zinc-900 dark:hover:bg-zinc-800"
            >
              {post.data.heroImage && (
                <div class="relative h-48 w-full overflow-hidden">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
              )}
              <div class="p-5">
                <div class="mb-3 flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                  <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                  <span aria-hidden="true">&middot;</span>
                  <span>{readingTime}</span>
                </div>
                <h2 class="text-lg font-semibold leading-tight text-stone-900 transition-colors group-hover:text-stone-700 dark:text-zinc-100 dark:group-hover:text-zinc-200">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm text-stone-600 dark:text-zinc-400">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {post.data.tags.map((tag) => (
                      <span class="inline-flex items-center rounded-full border border-neutral-200/80 bg-white px-2 py-0.5 text-[10px] font-semibold uppercase tracking-tighter text-stone-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</SiteShell>

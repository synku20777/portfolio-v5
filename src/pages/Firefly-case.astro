          <p class="text-neutral-600 dark:text-neutral-400">Team-based design process</p>
        </div>
        
        <!-- Task details - right column on mobile, right column on desktop -->
        <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
          <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Collaborative Design</strong>
          <div class="text-sm text-neutral-600 dark:text-neutral-400">Worked in Figma with two junior media designers on initial page design</div>
        </div>
      </div>
    </div>

    <!-- Step 6 -->
    <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
      <!-- Mobile & desktop timeline number -->
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-amber-500 text-white font-bold z-10 md:order-2">6</div>
      
      <!-- Content container for mobile - stacks vertically -->
      <div class="grid gap-4 md:contents">
        <!-- Phase title - right column on mobile, right column on desktop -->

          <div class="text-sm text-neutral-600 dark:text-neutral-400">Analyzed audience needs, rising interest in sustainable solutions, and competitive landscape</div>
        </div>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">

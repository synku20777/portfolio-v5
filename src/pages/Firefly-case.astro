---
export const prerender = true;
import { Button } from "@/components/ui/button";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import {
  IconBuildingSkyscraper,
  IconSearch,
  IconTarget,
  IconHeartHandshake,
  IconCheck,
  IconVideo,
  IconExternalLink,
  IconChevronRight,
  IconArrowRight,
  IconFlame,
  IconBrandFigma,
  IconPalette
} from "@tabler/icons-react";
import OptimizedImage from "@/components/optimizedImage.astro";

const meta = {
  title: "Case Study | Firefly Ecommerce Website",
  description:
    "Design and development of an ecommerce website for Firefly, an intelligent stove alarm that optimizes wood consumption for economic savings and environmental benefits.",
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    
      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
    <link rel="stylesheet" href="/src/styles/globals.css" />
  </head>

  <body class="bg-white dark:bg-black">
    <FloatingDockDemo client:load />

    <!-- Hero section with overlapping elements -->
    <header class="relative pt-20 pb-0 bg-gradient-to-br from-amber-50 to-neutral-100 dark:from-neutral-950 dark:to-amber-950 overflow-hidden">
      <div class="mx-auto max-w-7xl px-6">
        <a href="/" class="inline-flex items-center gap-2 mb-8 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back
        </a>

        <!-- Project metadata row -->
        <div class="flex flex-wrap gap-6 mb-6 text-sm">
          <div class="inline-block px-3 py-1 font-medium tracking-wider rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200">
            Ecommerce
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Client:</span>
            <span class="text-neutral-800 dark:text-neutral-200">Firefly</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Year:</span>
            <span class="text-neutral-800 dark:text-neutral-200">2024</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Role:</span>
            <span class="text-neutral-800 dark:text-neutral-200">UX/UI Designer</span>
          </div>
        </div>

        <!-- Main heading with visual interest -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="relative z-10">
            <div class="absolute -left-10 -top-10 w-32 h-32 bg-amber-100 dark:bg-amber-900 rounded-full opacity-50 blur-2xl"></div>
            <h1 class="relative text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-neutral-800 dark:text-neutral-100 mb-6">
              Firefly — Intelligent Stove Alarm
            </h1>
            <p class="text-lg md:text-xl text-neutral-700 dark:text-neutral-300 max-w-xl mb-10">
              An ecommerce website for an intelligent stove alarm that notifies users when firewood needs to be added, optimizing wood consumption for economic savings, reduced environmental impact, and greater in-home comfort.
            </p>
            
            <!-- Key outcomes in a horizontal list -->
            <div class="flex flex-wrap gap-4 mb-10">
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Environmental Benefits
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Economic Savings
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Enhanced Comfort
              </div>
            </div>
          </div>
          
          <div class="relative">
            <div class="absolute -right-40 -bottom-20 w-80 h-80 bg-amber-200 dark:bg-amber-800 rounded-full opacity-30 blur-3xl"></div>
            <div class="absolute right-20 top-10 w-32 h-32 bg-orange-200 dark:bg-orange-900 rounded-full opacity-30 blur-xl"></div>
            <div class="w-full rounded-xl overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
              <OptimizedImage
                src={import("../../public/photos/projects/Firefly/1.webp")}
                alt="Firefly Intelligent Stove Alarm hero image"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="flex justify-center mt-8 mb-4">
          <a href="#content" class="animate-bounce p-2 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm shadow-sm">
            <IconChevronRight className="w-5 h-5 text-neutral-500 dark:text-neutral-400 rotate-90" />
          </a>
        </div>
      </div>
    </header>

    <main id="content" class="py-24 bg-white dark:bg-black">
      <div class="mx-auto max-w-7xl px-6">
        <!-- Challenge and Solution in a card-based layout -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
          <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">The Challenge</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              Create an ecommerce website that effectively communicates the environmental, economic, and comfort benefits of using Firefly. The site needed to address both potential buyers and existing owners, including product instructions and documentation. The interface had to be simple and user-friendly, reflecting the product's philosophy of ease of use, while also delivering a new logo and visual demonstration of how the product works.
            </p>
          </div>

          <div class="bg-amber-50 dark:bg-amber-950 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">The Solution</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              A modern, responsive, and minimalist UI design that focused on clarity and intuitive navigation. The design process used Hick's Law to refine navigation and reduce decision time, along with clear, visually distinct calls-to-action. We delivered a new logo design following a flat, 2D monochrome direction, and created an animated infographic to visually demonstrate the product's functionality.
            </p>
          </div>
        </div>

        <!-- Design Process with visual timeline -->
<section class="mb-24 relative">

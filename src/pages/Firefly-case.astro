          <div class="text-sm text-neutral-600 dark:text-neutral-400">Conducted competitive scan, developed flat, 2D monochrome direction with wordmark options</div>
        </div>
      </div>
    </div>

    <!-- Step 5 -->
    <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
      <!-- Mobile & desktop timeline number -->

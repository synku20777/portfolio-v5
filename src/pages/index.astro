---
import "@/styles/globals.css";
import { BackgroundRippleEffectDemo } from "@/components/ui/bg-ripple";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import Works from "@/layouts/SelectedWorks.astro";
import About from "@/layouts/about.astro";
import Footer from "@/components/ui/footer";
import { StickyScrollRevealDemo } from "@/components/ui/services-section";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<script>
			// Simple path resolver for client-side scripts
			window.__resolve = (path) => {
				const base = '/src/';
				return path.replace(/^@\//, base);
			};
		</script>
		<script type="module">
			// Inline import with error handling
			try {
				const { initGallery } = await import('./src/lib/gallery.ts');
				initGallery({
					galleryId: "gallery",
					updateHash: true,
					scrollIntoView: false, // Disable auto-scrolling on hover
					hoverDelay: 100, // Small delay to prevent flickering on accidental hover
				});
			} catch (e) {
				console.error("Failed to initialize gallery:", e);
			}
		</script>
		<script is:inline>
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const isDark = getThemePreference() === 'dark';
			document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
		
			if (typeof localStorage !== 'undefined') {
				const observer = new MutationObserver(() => {
					const isDark = document.documentElement.classList.contains('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
			}
		</script>
		<meta name="Nest" content={Astro.generator} />
		<title>Nest Portfolio</title>
	</head>

	<body class="bg-white dark:bg-black">
		<FloatingDockDemo client:load />
		<BackgroundRippleEffectDemo client:load />
		<section id="services" class="bg-neutral-900 w-full py-4 dark:bg-neutral-900">
			<StickyScrollRevealDemo client:load/>
		</section>
		<Works />
		<About />
		<Footer name="Nest" client:load />
	</body>
</html>
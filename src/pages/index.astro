---
import BaseHead from "@/components/BaseHead.astro";
import "@/styles/globals.css";
import { BackgroundRippleEffectDemo } from "@/components/ui/bg-ripple";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import Works from "@/layouts/SelectedWorks.astro";
import About from "@/layouts/about.astro";
import Footer from "@/components/ui/footer";
import { StickyScrollRevealDemo } from "@/components/ui/services-section";
import { setupViewTransitions } from "@/lib/view-transitions";


const title = "Nest Portfolio | UX Designer & Frontend Developer";
const description = "Portfolio of a UX designer and frontend developer specializing in accessible, elegant web experiences";
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script define:vars={{ setupViewTransitions }}>
					document.addEventListener('DOMContentLoaded', setupViewTransitions);
				</script>
		<script>
			// Declare the custom property type
			declare global {
				interface Window {
					__resolve: (path: string) => string;
				}
			}
			
			// Simple path resolver for client-side scripts
			window.__resolve = (path: string) => {
				const base = '/src/';
				return path.replace(/^@\//, base);
			};
		</script>
		<script type="module" src="@/scripts/init-gallery.ts"></script>
		<script is:inline>
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const isDark = getThemePreference() === 'dark';
			document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
		
			if (typeof localStorage !== 'undefined') {
				const observer = new MutationObserver(() => {
					const isDark = document.documentElement.classList.contains('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
			}
		</script>
	</head>
	<body class="bg-white dark:bg-black">
		<FloatingDockDemo client:idle />
		<BackgroundRippleEffectDemo client:visible />
		<section id="services" class="bg-neutral-900 w-full py-4 dark:bg-neutral-900">
			<StickyScrollRevealDemo client:visible/>
		</section>
		<Works />
		<About />
		<Footer name="Nest" client:load />
	</body>
</html>
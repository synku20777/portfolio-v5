---
import BaseHead from "@/components/BaseHead.astro";
import "@/styles/globals.css";
import { BackgroundRippleEffectDemo } from "@/components/ui/bg-ripple";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import Works from "@/layouts/SelectedWorks.astro";
import About from "@/layouts/about.astro";
import Footer from "@/components/ui/footer";
import { StickyScrollRevealDemo } from "@/components/ui/services-section";
import { setupViewTransitions } from "@/lib/view-transitions";


const title = "Nest Portfolio | UX Designer & Frontend Developer";
const description = "Portfolio of a UX designer and frontend developer specializing in accessible, elegant web experiences";
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script define:vars={{ setupViewTransitions }}>
					document.addEventListener('DOMContentLoaded', setupViewTransitions);
				</script>
		<script is:inline>
			// Inline the entire gallery initialization to avoid external imports
			const initGallery = (opts = {}) => {
				const EASE = opts.easing ?? 'cubic-bezier(0.22, 1, 0.36, 1)';
				const DURATION = opts.duration ?? 420;
				const HOVER_DELAY = opts.hoverDelay ?? 0;

				const map = {
					"UxUnite.ds": "uxunite-case",
					"Artsy.app": "artsy-case",
					"Firefly.shop": "firefly-case",
					"CloudFirst.web": "cloudfirst-case",
					"Astra.web": "astra-case",
					"ITworkshop.web": "itworkshop-case",
					...(opts.nameToId ?? {}),
				};

				const CASE_IDS = [...(opts.caseIds ?? ["uxunite-case","artsy-case","cloudfirst-case","firefly-case","astra-case","itworkshop-case"])];

				let currentId = null;
				let ro = null;
				let hoverTimer = null;

				const getEl = (id) => document.getElementById(id);
				const galleryEl = () => document.getElementById(opts.galleryId ?? "gallery");

				const updateGalleryHeight = () => {
					// The gallery is now full height, so we don't need to adjust its height
					// Just ensure the active case fills the gallery properly
					const activeEl = currentId ? getEl(currentId) : null;
					if (activeEl) {
						activeEl.style.height = "100%";
						activeEl.style.display = "flex";
						activeEl.style.alignItems = "center";
						activeEl.style.justifyContent = "center";
					}
				};

				const observeActive = (el) => {
					if (typeof ResizeObserver === "undefined") return;
					
					if (!ro) ro = new ResizeObserver(updateGalleryHeight);
					ro.disconnect();
					if (el) ro.observe(el);
					
					window.removeEventListener("resize", updateGalleryHeight);
					window.addEventListener("resize", updateGalleryHeight, { passive: true });
					updateGalleryHeight();
				};

				const setActiveInstant = (id) => {
					CASE_IDS.forEach(cid => {
						const el = getEl(cid);
						if (!el) return;
						const active = cid === id;
						el.hidden = !active;
						el.dataset.active = active ? "true" : "false";
						el.setAttribute("aria-hidden", active ? "false" : "true");
						el.style.opacity = active ? "1" : "0";
						el.style.transform = active ? "translateX(0px)" : "translateX(40px)";
						el.style.zIndex = active ? "2" : "1";
					});
					currentId = id;
					updateGalleryHeight();
					observeActive(getEl(id));
				};

				const setActiveAnimated = async (id) => {
					if (id === currentId) return;

					const from = currentId ? getEl(currentId) : null;
					const to = getEl(id);
					if (!to) return;

					if (!CASE_IDS.includes(id)) CASE_IDS.push(id);

					to.hidden = false;
					to.dataset.active = "true";
					to.setAttribute("aria-hidden", "false");
					to.style.opacity = "0";
					to.style.transform = "translateX(-40px)";
					to.style.zIndex = "2";
					to.style.display = "flex";
					to.style.alignItems = "center";
					to.style.justifyContent = "center";

					const clean = (el) => {
						el.style.opacity = "";
						el.style.transform = "";
						el.style.zIndex = "";
						el.style.willChange = "";
					};

					let enterAnim = null;
					try {
						enterAnim = to.animate(
							[{ opacity: 0, transform: "translateX(-40px)" },
							{ opacity: 1, transform: "translateX(0px)" }],
							{ duration: DURATION, easing: EASE, fill: "forwards" }
						);
					} catch (e) {
						// Fallback if animation fails
						to.style.opacity = "1";
						to.style.transform = "translateX(0px)";
					}

					let exitAnim = null;
					if (from) {
						from.dataset.active = "false";
						from.setAttribute("aria-hidden", "true");
						from.style.zIndex = "1";
						try {
							exitAnim = from.animate(
								[{ opacity: 1, transform: "translateX(0px)" },
								{ opacity: 0, transform: "translateX(40px)" }],
								{ duration: DURATION, easing: EASE, fill: "forwards" }
							);
						} catch (e) {
							// Fallback if animation fails
							from.style.opacity = "0";
							from.style.transform = "translateX(40px)";
						}
					}

					try {
						if (enterAnim?.finished) await enterAnim.finished;
						if (exitAnim?.finished) await exitAnim.finished;
					} catch (e) {
						console.warn("Animation promise rejected", e);
					} finally {
						if (from) {
							from.hidden = true;
							clean(from);
						}
						clean(to);
						currentId = id;
						updateGalleryHeight();
						observeActive(to);
					}
				};

				const setActive = (id, { animate = true } = {}) =>
					animate ? setActiveAnimated(id) : setActiveInstant(id);

				const fallbackId = (name) =>
					((name?.split(".")[0] || "case"))
						.replace(/([a-z])([A-Z])/g, "$1-$2")
						.replace(/\s+/g, "-")
						.toLowerCase() + "-case";

				const boot = () => {
					const fromHash = location.hash?.slice(1);
					const initial = fromHash && CASE_IDS.includes(fromHash) ? fromHash : CASE_IDS[0];
					setActive(initial, { animate: false });
					observeActive(getEl(initial));
				};

				const onCaseOpen = (e) => {
					const name = e?.detail?.name;
					const id = map[name] || fallbackId(name);
					if (!CASE_IDS.includes(id)) CASE_IDS.push(id);
					
					// Clear any pending hover timer
					if (hoverTimer !== null) {
						clearTimeout(hoverTimer);
						hoverTimer = null;
					}
					
					// Set a delay if configured
					if (HOVER_DELAY > 0) {
						hoverTimer = window.setTimeout(() => {
							setActive(id, { animate: true });
							if (opts.updateHash !== false) {
								history.replaceState(null, "", `#${id}`);
							}
						}, HOVER_DELAY);
					} else {
						setActive(id, { animate: true });
						if (opts.updateHash !== false) {
							history.replaceState(null, "", `#${id}`);
						}
					}
				};

				if (document.readyState === 'loading') {
					document.addEventListener("DOMContentLoaded", boot, { once: true });
				} else {
					setTimeout(boot, 0);
				}
				window.addEventListener("case:open", onCaseOpen);

				return {
					setActive,
					destroy() {
						window.removeEventListener("case:open", onCaseOpen);
						window.removeEventListener("resize", updateGalleryHeight);
						if (ro) ro.disconnect();
						if (hoverTimer !== null) clearTimeout(hoverTimer);
					}
				};
			};
			
			// Initialize gallery
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', () => initGallery({
					galleryId: 'gallery',
					updateHash: true,
					scrollIntoView: true,
				}));
			} else {
				initGallery({
					galleryId: 'gallery',
					updateHash: true,
					scrollIntoView: true,
				});
			}
		</script>
		<script is:inline>
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const isDark = getThemePreference() === 'dark';
			document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
		
			if (typeof localStorage !== 'undefined') {
				const observer = new MutationObserver(() => {
					const isDark = document.documentElement.classList.contains('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
			}
		</script>
	</head>
	<body class="bg-white dark:bg-black">
		<FloatingDockDemo client:idle />
		<BackgroundRippleEffectDemo client:visible />
		<section id="services" class="bg-neutral-900 w-full py-4 dark:bg-neutral-900">
			<StickyScrollRevealDemo client:visible/>
		</section>
		<Works />
		<About />
		<Footer name="Nest" client:load />
	</body>
</html>
---
import BaseHead from "@/components/BaseHead.astro";
import "@/styles/globals.css";

// Layouts & Components
import About from "@/layouts/about.astro";
import Footer from "@/components/ui/footer";
import Bento from "@/layouts/WorksBento.astro";

// Interactive UI Components
import { BackgroundRippleEffectDemo } from "@/components/ui/abf";
import { FloatingDockDemo } from "@/components/ui/nav-dock";

// Libs
import { setupViewTransitions } from "@/lib/view-transitions";

const title = "Nest Portfolio | UX Designer & Frontend Developer";
const description = "Portfolio of a UX designer and frontend developer specializing in accessible, elegant web experiences";
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		
		{/* Theme Script: Must stay in HEAD to prevent flash of incorrect theme color */}
		<script is:inline>
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			
			const setDarkClass = () => {
				const isDark = getThemePreference() === 'dark';
				document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
			};

			setDarkClass(); // Run immediately

			// View Transitions hook to re-apply theme after swap
			document.addEventListener('astro:after-swap', setDarkClass);
		
			if (typeof localStorage !== 'undefined') {
				const observer = new MutationObserver(() => {
					const isDark = document.documentElement.classList.contains('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
			}
		</script>

		<script define:vars={{ setupViewTransitions }}>
			document.addEventListener('DOMContentLoaded', setupViewTransitions);
			document.addEventListener('astro:page-load', setupViewTransitions);
		</script>
	</head>
	
	<body class="bg-white dark:bg-black antialiased selection:bg-neutral-200 dark:selection:bg-neutral-800">
		{/* Navigation: client:load ensures nav is ready immediately */}
		<FloatingDockDemo client:load />
		
		<BackgroundRippleEffectDemo client:visible />
		<Bento />
		<About />
		<Footer name="Nest" client:visible />

		{/* Gallery Logic: Moved to end of body to unblock rendering */}
		<script is:inline>
			const initGallery = (opts = {}) => {
				const EASE = opts.easing ?? 'cubic-bezier(0.22, 1, 0.36, 1)';
				const DURATION = opts.duration ?? 420;
				const HOVER_DELAY = opts.hoverDelay ?? 0;

				const map = {
					"UxUnite.ds": "uxunite-case",
					"Artsy.app": "artsy-case",
					"Firefly.shop": "firefly-case",
					"CloudFirst.web": "cloudfirst-case",
					"Astra.web": "astra-case",
					"ITworkshop.web": "itworkshop-case",
					...(opts.nameToId ?? {}),
				};

				const CASE_IDS = opts.caseIds ?? ["uxunite-case","artsy-case","cloudfirst-case","firefly-case","astra-case","itworkshop-case"];

				let currentId = null;
				let ro = null;
				let hoverTimer = null;

				const getEl = (id) => document.getElementById(id);

				const updateGalleryHeight = () => {
					const activeEl = currentId ? getEl(currentId) : null;
					if (activeEl) {
						activeEl.style.height = "100%";
						activeEl.style.display = "flex";
						activeEl.style.alignItems = "center";
						activeEl.style.justifyContent = "center";
					}
				};

				const observeActive = (el) => {
					if (typeof ResizeObserver === "undefined") return;
					
					if (!ro) ro = new ResizeObserver(updateGalleryHeight);
					ro.disconnect();
					if (el) ro.observe(el);
					
					// Use a named function reference for cleaner removal if needed
					window.removeEventListener("resize", updateGalleryHeight);
					window.addEventListener("resize", updateGalleryHeight, { passive: true });
					updateGalleryHeight();
				};

				const setActiveInstant = (id) => {
					CASE_IDS.forEach(cid => {
						const el = getEl(cid);
						if (!el) return;
						const active = cid === id;
						
						// Performance: Batch style changes or use classes where possible
						el.hidden = !active;
						el.dataset.active = String(active);
						el.setAttribute("aria-hidden", String(!active));
						
						// Direct style manipulation for instant switch
						Object.assign(el.style, {
							opacity: active ? "1" : "0",
							transform: active ? "translateX(0px)" : "translateX(40px)",
							zIndex: active ? "2" : "1"
						});
					});
					currentId = id;
					updateGalleryHeight();
					observeActive(getEl(id));
				};

				const setActiveAnimated = async (id) => {
					if (id === currentId) return;

					const from = currentId ? getEl(currentId) : null;
					const to = getEl(id);
					if (!to) return; // Guard clause

					if (!CASE_IDS.includes(id)) CASE_IDS.push(id);

					// Prepare 'to' element
					to.hidden = false;
					to.dataset.active = "true";
					to.setAttribute("aria-hidden", "false");
					Object.assign(to.style, {
						opacity: "0",
						transform: "translateX(-40px)",
						zIndex: "2",
						display: "flex",
						alignItems: "center",
						justifyContent: "center"
					});

					const clean = (el) => {
						if(!el) return;
						el.style.opacity = "";
						el.style.transform = "";
						el.style.zIndex = "";
						el.style.willChange = "";
					};

					let enterAnim, exitAnim;

					try {
						enterAnim = to.animate(
							[{ opacity: 0, transform: "translateX(-40px)" },
							{ opacity: 1, transform: "translateX(0px)" }],
							{ duration: DURATION, easing: EASE, fill: "forwards" }
						);
					} catch (e) {
						to.style.opacity = "1";
						to.style.transform = "translateX(0px)";
					}

					if (from) {
						from.dataset.active = "false";
						from.setAttribute("aria-hidden", "true");
						from.style.zIndex = "1";
						try {
							exitAnim = from.animate(
								[{ opacity: 1, transform: "translateX(0px)" },
								{ opacity: 0, transform: "translateX(40px)" }],
								{ duration: DURATION, easing: EASE, fill: "forwards" }
							);
						} catch (e) {
							from.style.opacity = "0";
							from.style.transform = "translateX(40px)";
						}
					}

					try {
						await Promise.all([
							enterAnim?.finished,
							exitAnim?.finished
						]);
					} catch (e) {
						// Animation interrupted or failed
					} finally {
						if (from) {
							from.hidden = true;
							clean(from);
						}
						clean(to);
						currentId = id;
						updateGalleryHeight();
						observeActive(to);
					}
				};

				const setActive = (id, { animate = true } = {}) =>
					animate ? setActiveAnimated(id) : setActiveInstant(id);

				const fallbackId = (name) =>
					((name?.split(".")[0] || "case"))
						.replace(/([a-z])([A-Z])/g, "$1-$2")
						.replace(/\s+/g, "-")
						.toLowerCase() + "-case";

				const boot = () => {
					const fromHash = location.hash?.slice(1);
					const initial = fromHash && CASE_IDS.includes(fromHash) ? fromHash : CASE_IDS[0];
					if (initial) setActive(initial, { animate: false });
				};

				const onCaseOpen = (e) => {
					const name = e?.detail?.name;
					if (!name) return;

					const id = map[name] || fallbackId(name);
					if (!CASE_IDS.includes(id)) CASE_IDS.push(id);
					
					if (hoverTimer) {
						clearTimeout(hoverTimer);
						hoverTimer = null;
					}
					
					if (HOVER_DELAY > 0) {
						hoverTimer = window.setTimeout(() => {
							setActive(id, { animate: true });
							if (opts.updateHash !== false) history.replaceState(null, "", `#${id}`);
						}, HOVER_DELAY);
					} else {
						setActive(id, { animate: true });
						if (opts.updateHash !== false) history.replaceState(null, "", `#${id}`);
					}
				};

				// Cleanup previous listeners to prevent duplicates during navigation
				if (window._galleryCleanup) window._galleryCleanup();

				boot();
				window.addEventListener("case:open", onCaseOpen);

				// Register cleanup function globally
				window._galleryCleanup = () => {
					window.removeEventListener("case:open", onCaseOpen);
					window.removeEventListener("resize", updateGalleryHeight);
					if (ro) ro.disconnect();
					if (hoverTimer) clearTimeout(hoverTimer);
				};
			};
			
			// Initialize with View Transition support (astro:page-load)
			// This covers both initial load and subsequent client-side navigations
			const runGallery = () => {
				initGallery({
					galleryId: 'gallery',
					updateHash: true,
					scrollIntoView: true,
				});
			};

			document.addEventListener('astro:page-load', runGallery);
			// Fallback for non-ViewTransition setups
			if (document.readyState === 'complete') runGallery();
			else document.addEventListener('DOMContentLoaded', runGallery);
		</script>
	</body>
</html>
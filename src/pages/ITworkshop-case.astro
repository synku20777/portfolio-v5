---
export const prerender = true;
import { Button } from "@/components/ui/button";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import {
  IconBuildingSkyscraper,
  IconSearch,
  IconTarget,
  IconHeartHandshake,
  IconCheck,
  IconVideo,
  IconExternalLink,
  IconChevronRight,
  IconArrowRight,
  IconDeviceMobile,
  IconBrandFigma,
  IconBrandGithub,
  IconBrush
} from "@tabler/icons-react";
import OptimizedImage from "@/components/optimizedImage.astro";
import "../styles/globals.css";
const meta = {
  title: "Case Study | IT-Workshoppen Digital Presence",
  description:
    "Designing and developing a user-friendly, mobile-optimized website for IT-Workshoppen, creating a foundation for effective digital marketing in the IT instruction space.",
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    
      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
  </head>

  <body class="bg-white dark:bg-black">
    <FloatingDockDemo client:load />

    <!-- Hero section with overlapping elements -->
    <header class="relative pt-20 pb-0 bg-gradient-to-br from-indigo-50 to-neutral-100 dark:from-neutral-950 dark:to-indigo-950 overflow-hidden">
      <div class="mx-auto max-w-7xl px-6">
        <a href="/" class="inline-flex items-center gap-2 mb-8 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back
        </a>

        <!-- Project metadata row -->
        <div class="flex flex-wrap gap-6 mb-6 text-sm">
          <div class="inline-block px-3 py-1 font-medium tracking-wider rounded-full bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">
            Website
          </div>
          <div class="inline-block px-3 py-1 font-medium tracking-wider rounded-full bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">
            Branding
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Client:</span>
            <span class="text-neutral-800 dark:text-neutral-200">IT-Workshoppen (Denmark)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Role:</span>
            <span class="text-neutral-800 dark:text-neutral-200">UX/UI Designer & Front-end Developer</span>
          </div>
        </div>

        <!-- Main heading with visual interest -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="relative z-10">
            <div class="absolute -left-10 -top-10 w-32 h-32 bg-indigo-100 dark:bg-indigo-900 rounded-full opacity-50 blur-2xl"></div>
            <h1 class="relative text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-neutral-800 dark:text-neutral-100 mb-6">
              IT-Workshoppen — Digital Presence & Website
            </h1>
            <p class="text-lg md:text-xl text-neutral-700 dark:text-neutral-300 max-w-xl mb-10">
              Establishing a strong digital presence for a new Danish company focused on IT courses and instruction, reaching companies with employees who have limited IT understanding.
            </p>
            
            <!-- Key outcomes in a horizontal list -->
            <div class="flex flex-wrap gap-4 mb-10">
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Mobile-Optimized
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                WCAG Compliant
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Responsive Design
              </div>
            </div>
          </div>
          
          <div class="relative">
            <div class="absolute -right-40 -bottom-20 w-80 h-80 bg-indigo-200 dark:bg-indigo-800 rounded-full opacity-30 blur-3xl"></div>
            <div class="absolute right-20 top-10 w-32 h-32 bg-indigo-200 dark:bg-indigo-900 rounded-full opacity-30 blur-xl"></div>
            <div class="w-full rounded-xl overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
              <OptimizedImage
                src={import("../../public/photos/projects/It-Workshop/1.webp")}
                alt="IT-Workshoppen website preview"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="flex justify-center mt-8 mb-4">
          <a href="#content" class="animate-bounce p-2 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm shadow-sm">
            <IconChevronRight className="w-5 h-5 text-neutral-500 dark:text-neutral-400 rotate-90" />
          </a>
        </div>
      </div>
    </header>

    <main id="content" class="py-24 bg-white dark:bg-black">
      <div class="mx-auto max-w-7xl px-6">
        <!-- Challenge and Solution in a card-based layout -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
          <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">The Challenge</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              How might we develop a user-friendly, mobile-optimized website that improves the user experience and engages the target audience? How do we lay the foundation for effective digital marketing for the company?
            </p>
            <div class="mt-6 space-y-3">
              <div class="flex items-start gap-2">
                <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                <p class="text-neutral-600 dark:text-neutral-400">Limited brand recognition as a new company in the market</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                <p class="text-neutral-600 dark:text-neutral-400">Need for a modern, professional expression in digital space</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                <p class="text-neutral-600 dark:text-neutral-400">Reaching companies with employees having limited IT understanding</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                <p class="text-neutral-600 dark:text-neutral-400">Creating a website that prioritizes mobile optimization and usability</p>
              </div>
            </div>
          </div>

          <div class="bg-indigo-50 dark:bg-indigo-950 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">The Solution</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              A comprehensive website concept emphasizing usability and mobile optimization, with a redesigned logo for a modern, professional expression. The solution includes a prototype built in Figma, competitor and market research, and a design system with consistent components.
            </p>
            <div class="mt-8">
              <h3 class="font-semibold text-lg mb-2 text-neutral-800 dark:text-neutral-200">Project Scope:</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-indigo-500 dark:text-indigo-400 text-xl font-bold">01</span>
                  <span class="text-neutral-700 dark:text-neutral-300">User-friendly, mobile-optimized website</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-indigo-500 dark:text-indigo-400 text-xl font-bold">02</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Figma prototype development</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-indigo-500 dark:text-indigo-400 text-xl font-bold">03</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Competitor & market research</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-indigo-500 dark:text-indigo-400 text-xl font-bold">04</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Logo redesign & brand identity</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Research section -->
        <section class="mb-24 bg-gradient-to-br from-neutral-50 to-indigo-50 dark:from-neutral-900 dark:to-indigo-950 p-8 md:p-12 rounded-3xl relative overflow-hidden">
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-indigo-200 dark:bg-indigo-800 rounded-full opacity-20 blur-3xl"></div>
          
          <h2 class="text-2xl md:text-3xl font-bold mb-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 relative z-10">
            <IconSearch className="w-8 h-8 text-indigo-500" />
            <span>Research & Market Context</span>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
            <div class="col-span-1 md:col-span-2">
              <p class="text-neutral-600 dark:text-neutral-400 mb-6">
                An IT company delivering on-site IT-security training in Denmark is relatively unique. While online options exist, few offer the same personal, in-person approach—travelling directly to customers increases accessibility for those seeking IT-security instruction.
              </p>
              
              <div class="space-y-6 mt-8">
                <div class="bg-white dark:bg-neutral-800 p-6 rounded-xl shadow-sm">
                  <h4 class="font-bold text-lg text-neutral-800 dark:text-neutral-100">SWOT Analysis</h4>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-4">
                    <div>
                      <h5 class="font-semibold text-indigo-600 dark:text-indigo-400 mb-2">Strengths</h5>
                      <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Skilled instructors and high-quality materials</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Tailored training for company-specific needs</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Strong digital presentation through an intuitive website</span>
                        </li>
                      </ul>
                    </div>
                    <div>
                      <h5 class="font-semibold text-red-600 dark:text-red-400 mb-2">Weaknesses</h5>
                      <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>New brand with limited track record and testimonials</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Limited course variety, potentially narrowing the audience</span>
                        </li>
                      </ul>
                    </div>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-6">
                    <div>
                      <h5 class="font-semibold text-green-600 dark:text-green-400 mb-2">Opportunities</h5>
                      <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Rising demand for IT courses as even small businesses digitize</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Portfolio expansion to advanced technologies/sectors</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Ability to reach international markets via online delivery</span>
                        </li>
                      </ul>
                    </div>
                    <div>
                      <h5 class="font-semibold text-yellow-600 dark:text-yellow-400 mb-2">Threats</h5>
                      <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Competition from established providers and price pressure</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Rapid tech change requires constant material updates</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <span>•</span>
                          <span>Economic downturns can reduce training budgets</span>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="relative">
              <div class="sticky top-24 bg-white dark:bg-neutral-900 p-6 rounded-xl shadow-lg">
                <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Target Persona</h3>
                <div class="space-y-4">
                  <div>
                    <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-1">Renée</div>
                    <div class="text-neutral-800 dark:text-neutral-200">IT representative at Verninge Citizens' Association</div>
                  </div>
                  <div class="border-t border-neutral-200 dark:border-neutral-700 pt-4">
                    <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-1">Goals</div>
                    <div class="text-neutral-600 dark:text-neutral-400">Strengthen resilience against email scams/phishing</div>
                  </div>
                  <div class="border-t border-neutral-200 dark:border-neutral-700 pt-4">
                    <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-1">Challenges</div>
                    <div class="text-neutral-600 dark:text-neutral-400">Constrained by time and expertise with a small IT team handling email responses</div>
                  </div>
                  <div class="border-t border-neutral-200 dark:border-neutral-700 pt-4">
                    <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-1">Represents</div>
                    <div class="text-neutral-600 dark:text-neutral-400">Mid-sized organizations with limited resources/skills to educate staff on complex IT-security topics</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-16 rounded-xl shadow-lg overflow-hidden">
              <OptimizedImage
                src={import("../../public/photos/projects/It-Workshop/5.webp")}
                alt="IT-Workshoppen responsive design"
                class="w-full h-auto object-cover"
              />
          </div>
        </section>

        <!-- Design Process with visual timeline -->
        <section class="mb-24 relative">
          <!-- Timeline vertical line - only visible on md+ screens -->
          <div class="absolute left-1/2 top-28 bottom-0 w-1 bg-neutral-200 dark:bg-neutral-800 -translate-x-1/2 hidden md:block"></div>
          
          <!-- Mobile timeline line - left aligned -->
          <div class="absolute left-6 top-28 bottom-0 w-1 bg-neutral-200 dark:bg-neutral-800 md:hidden"></div>
          
          <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-neutral-800 dark:text-neutral-100">Design Process</h2>
          
          <div class="space-y-12 relative">
            <!-- Step 1 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number (always left on mobile) -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-500 text-white font-bold z-10 md:order-2">1</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, left column on desktop -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Style-tiles & Moodboards</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Individual exploration and team alignment on visual direction</p>
                </div>
                
                <!-- Task details - right column on mobile, right column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Color Exploration</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Aligned on blue as primary color choice for its trustworthiness and common usage in IT sector</div>
                </div>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-500 text-white font-bold z-10 md:order-2">2</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, right column on desktop -->
                <div class="order-1 md:order-3">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Wireframes</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Creating the structural foundation using design principles</p>
                </div>
                
                <!-- Task details - right column on mobile, left column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-1">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Design Principles</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Built wireframes using Gestalt, POUR, and CRAP principles for visual harmony and intuitive user experience</div>
                </div>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-500 text-white font-bold z-10 md:order-2">3</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, left column on desktop -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Design System</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Creating a UI kit with standardized components</p>
                </div>
                
                <!-- Task details - right column on mobile, right column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Design Audit</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Performed a design audit to lock header, footer, color palette, and type system; created a UI kit that standardized buttons and components</div>
                </div>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-500 text-white font-bold z-10 md:order-2">4</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, right column on desktop -->
                <div class="order-1 md:order-3">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Prototype Development</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Building the interactive Figma prototype</p>
                </div>
                
                <!-- Task details - right column on mobile, left column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-1">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Mobile-First Approach</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Started with mobile design then scaled to tablet/desktop; implemented responsive burger menu, blue primary CTAs, and a testimonial carousel</div>
                </div>
              </div>
            </div>

            <!-- Step 5 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-500 text-white font-bold z-10 md:order-2">5</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, left column on desktop -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Logo Redesign</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Updating the brand identity</p>
                </div>
                
                <!-- Task details - right column on mobile, right column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Brand Evolution</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Transformed the original owl logo into a shield with a mouse click symbol for clearer IT-security association</div>
                </div>
              </div>
            </div>

            <!-- Step 6 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-500 text-white font-bold z-10 md:order-2">6</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, right column on desktop -->
                <div class="order-1 md:order-3">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Development Setup</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Preparing for front-end implementation</p>
                </div>
                
                <!-- Task details - right column on mobile, left column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-1">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">GitHub Environment</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Set up GitHub collaboration environment; divided pages and components between team members</div>
                </div>
              </div>
            </div>

            <!-- Step 7 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-500 text-white font-bold z-10 md:order-2">7</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, left column on desktop -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Responsive Implementation</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Building the responsive front-end</p>

---
export const prerender = true;
import { Button } from "@/components/ui/button";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import {
  IconBuildingSkyscraper,
  IconSearch,
  IconTarget,
  IconHeartHandshake,
  IconCheck,
  IconVideo,
  IconExternalLink,
  IconChevronRight,
  IconArrowRight,
  IconDeviceMobile,
  IconPalette,
  IconUser
} from "@tabler/icons-react";
import OptimizedImage from "@/components/optimizedImage.astro";

const meta = {
  title: "Case Study | Artsy Museum Experience App",
  description:
    "Artsy personalizes museum visits, aggregates ticketing across venues, and turns static exhibits into connected stories—especially helpful for tourists or visitors in unfamiliar cities.",
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    
      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
    <link rel="stylesheet" href="/src/styles/globals.css" />
  </head>

  <body class="bg-white dark:bg-black">
    <FloatingDockDemo client:load />

    <!-- Hero section with overlapping elements -->
    <header class="relative pt-20 pb-0 bg-gradient-to-br from-neutral-50 to-neutral-100 dark:from-neutral-950 dark:to-neutral-950 overflow-hidden">
      <div class="mx-auto max-w-7xl px-6">
        <a href="/" class="inline-flex items-center gap-2 mb-8 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back
        </a>

        <!-- Project metadata row -->
        <div class="flex flex-wrap gap-6 mb-6 text-sm">
          <div class="inline-block px-3 py-1 font-medium tracking-wider rounded-full bg-neutral-200 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
            Mobile App
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Role:</span>
            <span class="text-neutral-800 dark:text-neutral-200">Product/UX Designer</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Duration:</span>
            <span class="text-neutral-800 dark:text-neutral-200">3-week sprint + 1-week revisit</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Tools:</span>
            <span class="text-neutral-800 dark:text-neutral-200">Figma (mobile), Paper sketching</span>
          </div>
        </div>

        <!-- Main heading with visual interest -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="relative z-10">
            <div class="absolute -left-10 -top-10 w-32 h-32 bg-neutral-100 dark:bg-neutral-900 rounded-full opacity-50 blur-2xl"></div>
            <h1 class="relative text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-neutral-800 dark:text-neutral-100 mb-6">
              Artsy — Enhancing Museum Experience & Personalization
            </h1>
            <p class="text-lg md:text-xl text-neutral-700 dark:text-neutral-300 max-w-xl mb-10">
              A concept app that personalizes museum visits, aggregates ticketing across venues, and turns static exhibits into connected stories—especially helpful for tourists or visitors in unfamiliar cities.
            </p>
            
            <!-- Key outcomes in a horizontal list -->
            <div class="flex flex-wrap gap-4 mb-10">
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Personalized Guided Tours
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Art Database
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Ticket Aggregation
              </div>
            </div>
          </div>
          
          <div class="relative">
            <div class="absolute -right-40 -bottom-20 w-80 h-80 bg-neutral-200 dark:bg-neutral-800 rounded-full opacity-30 blur-3xl"></div>
            <div class="absolute right-20 top-10 w-32 h-32 bg-neutral-200 dark:bg-neutral-900 rounded-full opacity-30 blur-xl"></div>
            <div class="w-full rounded-xl overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
              <OptimizedImage
                src={import("../../public/photos/projects/Artsy/1.webp")}
                alt="Artsy Museum App hero image"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="flex justify-center mt-8 mb-4">
          <a href="#content" class="animate-bounce p-2 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm shadow-sm">
            <IconChevronRight className="w-5 h-5 text-neutral-500 dark:text-neutral-400 rotate-90" />
          </a>
        </div>
      </div>
    </header>

    <main id="content" class="py-24 bg-white dark:bg-black">
      <div class="mx-auto max-w-7xl px-6">
        <!-- Challenge and Solution in a card-based layout -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
          <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">The Problem</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              The current art-presentation scene is perceived as elitist and hard to access. People want to learn about art but often don't know where to begin or find nothing personal to connect with. Ticket pre-orders can be confusing, and exhibit storytelling feels inconsistent and impersonal.
            </p>
            <div class="mt-6 space-y-3">
              <div class="flex items-start gap-2">
                <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                <p class="text-neutral-600 dark:text-neutral-400">Users struggle to pre-order tickets online for some exhibitions.</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                <p class="text-neutral-600 dark:text-neutral-400">Museum storytelling lacks connectivity and personality between pieces.</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                <p class="text-neutral-600 dark:text-neutral-400">In an unfamiliar environment, it's hard to plan what to see and navigate.</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                <p class="text-neutral-600 dark:text-neutral-400">Notes beside artworks rarely explain process, artist insight, or ideation, so stories don't speak to the audience.</p>
              </div>
            </div>
          </div>

          <div class="bg-neutral-50 dark:bg-neutral-950 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">The Solution</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              Create an accessible app offering personalized guided tours and an art database, reducing boredom from generic tours by tailoring experiences to user interests—plus a single aggregator for purchasing tickets.
            </p>
            <div class="mt-8">
              <h3 class="font-semibold text-lg mb-2 text-neutral-800 dark:text-neutral-200">Key Features:</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-neutral-500 dark:text-neutral-400 text-xl font-bold">01</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Personalized tours based on interests</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-neutral-500 dark:text-neutral-400 text-xl font-bold">02</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Ticket aggregation across venues</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-neutral-500 dark:text-neutral-400 text-xl font-bold">03</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Interactive navigation maps</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-neutral-500 dark:text-neutral-400 text-xl font-bold">04</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Deep artwork context and stories</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Research section -->
        <section class="mb-24 bg-gradient-to-br from-neutral-50 to-neutral-50 dark:from-neutral-900 dark:to-neutral-950 p-8 md:p-12 rounded-3xl relative overflow-hidden">
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-neutral-200 dark:bg-neutral-800 rounded-full opacity-20 blur-3xl"></div>
          
          <h2 class="text-2xl md:text-3xl font-bold mb-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 relative z-10">
            <IconSearch className="w-8 h-8 text-neutral-500" />
            <span>Research</span>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
            <div class="col-span-1 md:col-span-2">
              <p class="text-neutral-600 dark:text-neutral-400 mb-6">
                We conducted 12 interviews (5 male, 6 female, 1 queer) to surface needs, goals, and frustrations across visitor types. This helped us understand the various pain points museum visitors experience and how we might address them.
              </p>
              
              <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Personas</h3>
              
              <div class="space-y-6 mt-6">
                <div class="bg-white dark:bg-neutral-800 p-6 rounded-xl shadow-sm">
                  <h4 class="font-bold text-lg text-neutral-800 dark:text-neutral-100">Sofie (26, Copenhagen, SMM)</h4>
                  <p class="text-neutral-600 dark:text-neutral-400 mt-2">Loves art and history, wants deeper stories to share with friends; struggles with queues, navigation, superficial trivia, and inconsistent storytelling; bad eyesight noted.</p>
                  <p class="mt-4 italic text-neutral-500 dark:text-neutral-400">"I would want to own a Klimt painting, but the golden leaf must be sooo expensive…"</p>
                </div>
                
                <div class="bg-white dark:bg-neutral-800 p-6 rounded-xl shadow-sm">
                  <h4 class="font-bold text-lg text-neutral-800 dark:text-neutral-100">Nikolaj (26, Vilnius, Barista)</h4>
                  <p class="text-neutral-600 dark:text-neutral-400 mt-2">Visits with school/friends; cares more about interactive experiences than content depth; needs student discounts, good interaction design, and not to feel lonely.</p>
                  <p class="mt-4 italic text-neutral-500 dark:text-neutral-400">"Art is something you have to experience and try yourself before talking about it…"</p>
                </div>
                
                <div class="bg-white dark:bg-neutral-800 p-6 rounded-xl shadow-sm">
                  <h4 class="font-bold text-lg text-neutral-800 dark:text-neutral-100">Albert (50, Berlin, Surgeon)</h4>
                  <p class="text-neutral-600 dark:text-neutral-400 mt-2">Tight schedule; family-oriented outings; seeks behind-the-scenes, process, and author's perspective; hates crowds and ticket-finding friction.</p>
                </div>
              </div>
            </div>
            
            <div class="relative">
              <div class="sticky top-24 bg-white dark:bg-neutral-900 p-6 rounded-xl shadow-lg">
                <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Journey Highlights</h3>
                <div class="space-y-6">
                  <div class="pb-3">
                    <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-2">Planning with friends</div>
                    <div class="text-neutral-600 dark:text-neutral-400 mb-3">Finding who's interested, picking a venue, comparing offers/discounts, and coordinating tickets; feelings swing from excitement → overwhelm → confusion.</div>
                    <div class="mt-3 text-sm font-medium text-neutral-600 dark:text-neutral-400 mb-1">Opportunities:</div>
                    <div class="text-sm text-neutral-600 dark:text-neutral-400">Save to calendar & share, personalized search.</div>
                  </div>
                  <div class="border-t border-neutral-200 dark:border-neutral-800">
                    <div class="py-4 text-sm font-medium text-neutral-500 dark:text-neutral-400">Solo gallery visit</div>
                    <div class="text-neutral-600 dark:text-neutral-400 mb-3">Search venues, book a guide, show tickets, explore, gift-shop; emotions shift frustrated → excited → dissatisfied/satisfied.</div>
                    <div class="mt-3 text-sm font-medium text-neutral-600 dark:text-neutral-400 mb-1">Opportunities:</div>
                    <div class="text-sm text-neutral-600 dark:text-neutral-400">Self-guided tours and an interactive map tailored to the user.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Design Process with visual timeline -->
        <section class="mb-24 relative">
          <!-- Timeline vertical line - only visible on md+ screens -->
          <div class="absolute left-1/2 top-28 bottom-0 w-1 bg-neutral-200 dark:bg-neutral-800 -translate-x-1/2 hidden md:block"></div>
          
          <!-- Mobile timeline line - left aligned -->
          <div class="absolute left-6 top-28 bottom-0 w-1 bg-neutral-200 dark:bg-neutral-800 md:hidden"></div>
          
          <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-neutral-800 dark:text-neutral-100">Design Process</h2>
          
          <div class="space-y-12 relative">
            <!-- Step 1 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number (always left on mobile) -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-neutral-500 text-white font-bold z-10 md:order-2">1</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, left column on desktop -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Ideation</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Running creative exercises to explore solution spaces</p>
                </div>
                
                <!-- Task details - right column on mobile, right column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Collaborative ideation</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Ran "Crazy 8's", "How might we…" prompts, and group brainstorming with interviewees to map solution spaces around ticketing, navigation, and storytelling depth.</div>
                </div>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-neutral-500 text-white font-bold z-10 md:order-2">2</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, right column on desktop -->
                <div class="order-1 md:order-3">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Low-Fidelity Wireframes</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Paper sketching for rapid iteration</p>
                </div>
                
                <!-- Task details - right column on mobile, left column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-1">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Rapid iteration</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Quick ideation on paper to focus on structure and user flows rather than visual details; enabled rapid iteration against the identified problems.</div>
                </div>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-neutral-500 text-white font-bold z-10 md:order-2">3</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, left column on desktop -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">High-Fidelity Prototype</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Creating a detailed mobile prototype in Figma</p>
                </div>
                
                <!-- Task details - right column on mobile, right column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Realistic prototype</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Integrated new visuals, smoother interactions, and realistic content; refined UX based on user insights and heuristic evaluation, yielding a prototype that closely resembles the end-user experience.</div>
                </div>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Mobile & desktop timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-neutral-500 text-white font-bold z-10 md:order-2">4</div>
              
              <!-- Content container for mobile - stacks vertically -->
              <div class="grid gap-4 md:contents">
                <!-- Phase title - right column on mobile, right column on desktop -->
                <div class="order-1 md:order-3">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Visual Direction</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Establishing typography and stylistic elements</p>
                </div>
                
                <!-- Task details - right column on mobile, left column on desktop -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-1">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Visual identity</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">
                    <p>Typeface: <span class="font-medium">Gilroy</span> (Regular & Bold).</p>
                    <p class="mt-2">Stylistic references: <span class="font-medium">Suprematism</span> and <span class="font-medium">Constructivism</span>—geometric, flat, limited color selections—applied to keep the interface clean, legible, and modern.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Proposed Experience section -->
        <section class="mb-24">
          <div class="flex items-center mb-12">
            <div class="h-px bg-neutral-200 dark:bg-neutral-800 flex-grow"></div>
            <h2 class="text-2xl md:text-3xl font-bold px-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 whitespace-nowrap">
              <IconDeviceMobile className="w-8 h-8 text-neutral-500" />
              <span>Proposed Experience</span>
            </h2>
            <div class="h-px bg-neutral-200 dark:bg-neutral-800 flex-grow"></div>
          </div>
          
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-xl">
              <h3 class="text-xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Personalized Tours</h3>
              <div class="bg-white dark:bg-neutral-800 rounded-lg shadow-lg overflow-hidden">
              <OptimizedImage
                src={import("../../public/photos/projects/Artsy/2.webp")}
                alt="Personalized tours interface"
                class="w-full h-auto"
              />
              </div>
              <p class="text-neutral-600 dark:text-neutral-400 mt-6">
              Recommend routes and pieces based on interests (e.g., artist process, WIP, author's life). Users can select preferences and receive tailored experiences that match their specific interests, making each museum visit unique.
              </p>
            </div>
            
            <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-xl">
              <h3 class="text-xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Ticket Aggregator</h3>
              <div class="bg-white dark:bg-neutral-800 rounded-lg shadow-lg overflow-hidden">
              <OptimizedImage
                src={import("../../public/photos/projects/Artsy/3.webp")}
                alt="Ticket aggregator interface"
                class="w-full h-auto"
              />
              </div>
              <p class="text-neutral-600 dark:text-neutral-400 mt-6">
              One place to discover exhibits, compare offers/discounts, and pre-order tickets. This solves the frustration of navigating multiple websites for different venues and ensures a seamless booking experience.
              </p>
            </div>
            
            <div class="lg:col-span-2 bg-neutral-50 dark:bg-neutral-900 p-8 rounded-xl">
              <h3 class="text-xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">Interactive prototype</h3>
              <div class="bg-white dark:bg-neutral-800 rounded-lg shadow-lg overflow-hidden">
              <img
                src="/photos/projects/Artsy/4.webp"
                alt="Interactive map interface"
                class="w-full h-auto"
              />
              </div>
              <p class="text-neutral-600 dark:text-neutral-400 mt-6">
              In-museum navigation with highlights for each persona's goals (e.g., deep stories vs. playful interactions). The interactive maps help visitors navigate unfamiliar spaces confidently while calling attention to content that matches their personal preferences.
              </p>
            </div>
            </div>
        </section>

        <!-- Persona-based approach section -->
        <section class="mb-24 bg-neutral-50 dark:bg-neutral-950 p-8 md:p-12 rounded-3xl relative overflow-hidden">
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-neutral-200 dark:bg-neutral-800 rounded-full opacity-20 blur-3xl"></div>
          
          <h2 class="text-2xl md:text-3xl font-bold mb-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 relative z-10">
            <IconUser className="w-8 h-8 text-neutral-500" />
            <span>Persona-Based Features</span>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
            <div class="col-span-1 md:col-span-3">
              <p class="text-neutral-600 dark:text-neutral-400 mb-8 max-w-3xl">
                Each feature was designed to address specific needs of our research-derived personas, ensuring the app would provide real value to different types of museum visitors.
              </p>
            </div>
            
            <div class="bg-white dark:bg-neutral-900 p-6 rounded-xl shadow-sm">
              <h3 class="font-bold text-lg mb-3 text-neutral-800 dark:text-neutral-100">For Sofie</h3>
              <ul class="space-y-2 text-neutral-600 dark:text-neutral-400">
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Deep stories about artwork and artists</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>High contrast text for better readability</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 mt-1">•</span>
                  <span>Social sharing of discoveries</span>
                </li>
              </ul>

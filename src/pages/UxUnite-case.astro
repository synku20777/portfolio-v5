---
export const prerender = true;
import { Button } from "@/components/ui/button";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import {
  IconCheck,
  IconVideo,
  IconExternalLink,
  IconChevronRight,
  IconArrowRight,
  IconPalette,
  IconEye,
  IconTypography
} from "@tabler/icons-react";
import OptimizedImage from "@/components/optimizedImage.astro";
import "../styles/globals.css";
const meta = {
  title: "Case Study | UxUnite Design System",
  description:
    "Developing a design system that helps teams work together, follow brand guidelines, and create outstanding software experiences.",
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    
      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
  </head>

  <body class="bg-white dark:bg-black">
    <FloatingDockDemo client:load />

    <!-- Hero section with overlapping elements -->
    <header class="relative pt-20 pb-0 bg-gradient-to-br from-blue-50 to-neutral-100 dark:from-neutral-950 dark:to-blue-950 overflow-hidden">
      <div class="mx-auto max-w-7xl px-6">
        <a href="/" class="inline-flex items-center gap-2 mb-8 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back
        </a>

        <!-- Project metadata row -->
        <div class="flex flex-wrap gap-6 mb-6 text-sm">
          <div class="inline-block px-3 py-1 font-medium tracking-wider rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
            Design System
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Client:</span>
            <span class="text-neutral-800 dark:text-neutral-200">UxUnite</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Duration:</span>
            <span class="text-neutral-800 dark:text-neutral-200">2022</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Tools:</span>
            <span class="text-neutral-800 dark:text-neutral-200">Figma, Leonardo Color</span>
          </div>
        </div>

        <!-- Main heading with visual interest -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="relative z-10">
            <div class="absolute -left-10 -top-10 w-32 h-32 bg-blue-100 dark:bg-blue-900 rounded-full opacity-50 blur-2xl"></div>
            <h1 class="relative text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-neutral-800 dark:text-neutral-100 mb-6">
              UxUnite Design System
            </h1>
            <p class="text-lg md:text-xl text-neutral-700 dark:text-neutral-300 max-w-xl mb-10">
              Developing a comprehensive design system that helps teams work together, follow brand guidelines, and create outstanding software experiences.
            </p>
            
            <!-- Key outcomes in a horizontal list -->
            <div class="flex flex-wrap gap-4 mb-10">
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Unified Design Language
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Improved Accessibility
              </div>
              <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                Enhanced Collaboration
              </div>
            </div>
          </div>
          
          <div class="relative">
            <div class="absolute -right-40 -bottom-20 w-80 h-80 bg-blue-200 dark:bg-blue-800 rounded-full opacity-30 blur-3xl"></div>
            <div class="absolute right-20 top-10 w-32 h-32 bg-cyan-200 dark:bg-cyan-900 rounded-full opacity-30 blur-xl"></div>
            <div class="w-full rounded-xl overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
              <OptimizedImage
                src={import("../../public/photos/projects/UxUnite/1.webp")}
                alt="UxUnite Design System hero image"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="flex justify-center mt-8 mb-4">
          <a href="#content" class="animate-bounce p-2 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm shadow-sm">
            <IconChevronRight className="w-5 h-5 text-neutral-500 dark:text-neutral-400 rotate-90" />
          </a>
        </div>
      </div>
    </header>

    <main id="content" class="py-24 bg-white dark:bg-black">
      <div class="mx-auto max-w-7xl px-6">
        <!-- Challenge and Solution in a card-based layout -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
          <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">The Challenge</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              The website structure needed breaking down, inconsistencies identified through an audit, and the existing UI kit adjusted for edge cases. The color palette looked outdated, colors felt faded and worn, and didn't comply with WCAG accessibility standards. Additionally, the palette didn't reflect the community-driven product vision.
            </p>
          </div>

          <div class="bg-blue-50 dark:bg-blue-950 p-8 rounded-2xl shadow-sm">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-neutral-800 dark:text-neutral-100">The Solution</h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              We implemented a comprehensive design system that supports new features, future scaling, and individual contribution. This included a modernized color palette with accessibility considerations using Leonardo Color, a typographic system with a 1.25× modular scale ratio, and a hardened UI kit that covered all edge cases.
            </p>
          </div>
        </div>

        <!-- Process with visual timeline -->
        <section class="mb-24 relative">
          <!-- Timeline vertical line - only visible on md+ screens -->
          <div class="absolute left-1/2 top-28 bottom-0 w-1 bg-neutral-200 dark:bg-neutral-800 -translate-x-1/2 hidden md:block"></div>
          
          <!-- Mobile timeline line - left aligned -->
          <div class="absolute left-6 top-28 bottom-0 w-1 bg-neutral-200 dark:bg-neutral-800 md:hidden"></div>
          
          <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-neutral-800 dark:text-neutral-100">Design Process</h2>
          
          <div class="space-y-12 relative">
            <!-- Step 1 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-500 text-white font-bold z-10 md:order-2">1</div>
              
              <!-- Content container -->
              <div class="grid gap-4 md:contents">
                <!-- Title -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Design Audit</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Led by a Figma expert to clarify priorities</p>
                </div>
                
                <!-- Details -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Alignment Workshop</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Started the design-system process with an audit workshop to establish foundations</div>
                </div>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-500 text-white font-bold z-10 md:order-2">2</div>
              
              <!-- Content container -->
              <div class="grid gap-4 md:contents">
                <!-- Title -->
                <div class="order-1 md:order-3">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Structure & UI Kit Hardening</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Breaking down site structure and addressing inconsistencies</p>
                </div>
                
                <!-- Details -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-1">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Component Audit</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Catalogued inconsistencies and adjusted the existing UI kit to cover edge cases</div>
                </div>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-500 text-white font-bold z-10 md:order-2">3</div>
              
              <!-- Content container -->
              <div class="grid gap-4 md:contents">
                <!-- Title -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Branding Research</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Analyzing brand values and visual identity</p>
                </div>
                
                <!-- Details -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Color Analysis</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Step one in the color workflow to inform palette modernization</div>
                </div>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-500 text-white font-bold z-10 md:order-2">4</div>
              
              <!-- Content container -->
              <div class="grid gap-4 md:contents">
                <!-- Title -->
                <div class="order-1 md:order-3">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Color System Development</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Creating accessible, brand-aligned color palettes</p>
                </div>
                
                <!-- Details -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-1">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Leonardo Color Implementation</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Used Leonardo Color to make accessibility adjustments to palette</div>
                </div>
              </div>
            </div>

            <!-- Step 5 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-500 text-white font-bold z-10 md:order-2">5</div>
              
              <!-- Content container -->
              <div class="grid gap-4 md:contents">
                <!-- Title -->
                <div class="order-1 md:order-1 md:text-right">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Typography System</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Building a modular type scale with accessibility focus</p>
                </div>
                
                <!-- Details -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-3">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Typographic Systemization</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Implemented 1.25× modular scale with accessibility-minded spacing parameters</div>
                </div>
              </div>
            </div>

            <!-- Step 6 -->
            <div class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-4 md:gap-8 items-start md:items-center relative">
              <!-- Timeline number -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-500 text-white font-bold z-10 md:order-2">6</div>
              
              <!-- Content container -->
              <div class="grid gap-4 md:contents">
                <!-- Title -->
                <div class="order-1 md:order-3">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Client Review</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">Presenting and refining the design system</p>
                </div>
                
                <!-- Details -->
                <div class="order-2 bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl shadow-sm md:order-1">
                  <strong class="block text-neutral-800 dark:text-neutral-200 mb-1">Collaborative Refinement</strong>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">Making final tweaks to the design system based on client feedback</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Color system details section -->
        <section class="mb-24 bg-gradient-to-br from-neutral-50 to-blue-50 dark:from-neutral-900 dark:to-blue-950 p-8 md:p-12 rounded-3xl relative overflow-hidden">
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-blue-200 dark:bg-blue-800 rounded-full opacity-20 blur-3xl"></div>
          
          <h2 class="text-2xl md:text-3xl font-bold mb-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 relative z-10">
            <IconPalette className="w-8 h-8 text-blue-500" />
            <span>Color System Implementation</span>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
            <div class="col-span-1 md:col-span-2">
              <p class="text-neutral-600 dark:text-neutral-400 mb-6">
                We implemented a stepwise color workflow to modernize the palette while ensuring accessibility compliance and alignment with the community-driven product vision.
              </p>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-blue-500 dark:text-blue-400 text-xl font-bold">01</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Branding research analysis</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-blue-500 dark:text-blue-400 text-xl font-bold">02</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Adjusting colors based on findings</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-blue-500 dark:text-blue-400 text-xl font-bold">03</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Accessibility adjustments with Leonardo</span>
                </div>
                <div class="flex items-center gap-3 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm p-4 rounded-lg">
                  <span class="text-blue-500 dark:text-blue-400 text-xl font-bold">04</span>
                  <span class="text-neutral-700 dark:text-neutral-300">Presentation and client tweaks</span>
                </div>
              </div>
            </div>
            
            <div class="relative">
              <div class="sticky top-24 bg-white dark:bg-neutral-900 p-6 rounded-xl shadow-lg">
                <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Color Tools Used</h3>
                <div class="space-y-4">
                  <div>
                    <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-1">Primary tools</div>
                    <div class="text-neutral-800 dark:text-neutral-200">Leonardo Color, Figma</div>
                  </div>
                  <div>
                    <Button asChild variant="outline" className="w-full justify-between">
                      <a href="https://leonardocolor.io/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
                        Learn about Leonardo
                        <IconArrowRight className="h-4 w-4" />
                      </a>
                    </Button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Typography section -->
        <section class="mb-24">
          <h2 class="text-2xl md:text-3xl font-bold mb-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100">
            <IconTypography className="w-8 h-8 text-blue-500" />
            <span>Typography System</span>
          </h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-xl">
              <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Type Scale</h3>
              <p class="text-neutral-600 dark:text-neutral-400 mb-6">
                To create a clear hierarchy, we implemented a modular scale ratio of 1.25× with a 16px base size. This provides consistent progression through heading levels and text elements.
              </p>
              
              <div class="space-y-4 mt-6">
                <div class="flex flex-col">
                  <span class="text-5xl font-bold text-neutral-800 dark:text-neutral-200">Heading 1</span>
                  <span class="text-sm text-neutral-500 dark:text-neutral-400">31.25px (1.25^5 × 16px)</span>
                </div>
                <div class="flex flex-col">
                  <span class="text-4xl font-bold text-neutral-800 dark:text-neutral-200">Heading 2</span>
                  <span class="text-sm text-neutral-500 dark:text-neutral-400">25px (1.25^4 × 16px)</span>
                </div>
                <div class="flex flex-col">
                  <span class="text-3xl font-bold text-neutral-800 dark:text-neutral-200">Heading 3</span>
                  <span class="text-sm text-neutral-500 dark:text-neutral-400">20px (1.25^3 × 16px)</span>
                </div>
                <div class="flex flex-col">
                  <span class="text-2xl font-bold text-neutral-800 dark:text-neutral-200">Heading 4</span>
                  <span class="text-sm text-neutral-500 dark:text-neutral-400">16px (base size)</span>
                </div>
              </div>
            </div>
            
            <div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-xl">
              <h3 class="text-xl font-bold mb-4 text-neutral-800 dark:text-neutral-100">Accessibility Enhancements</h3>
              <p class="text-neutral-600 dark:text-neutral-400 mb-6">
                Accessibility-focused refinements included careful attention to spacing parameters across all typography elements:
              </p>
              
              <div class="space-y-4">
                <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-700 pb-2">
                  <span class="font-medium text-neutral-800 dark:text-neutral-200">Line Height</span>
                  <span class="text-neutral-600 dark:text-neutral-400">1.5</span>
                </div>
                <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-700 pb-2">
                  <span class="font-medium text-neutral-800 dark:text-neutral-200">Letter Spacing</span>
                  <span class="text-neutral-600 dark:text-neutral-400">0.12</span>
                </div>
                <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-700 pb-2">
                  <span class="font-medium text-neutral-800 dark:text-neutral-200">Word Spacing</span>
                  <span class="text-neutral-600 dark:text-neutral-400">0.16</span>
                </div>
              </div>
              
              <p class="text-neutral-600 dark:text-neutral-400 mt-6">
                These parameters ensure readable text across all surfaces and devices, significantly enhancing the user experience for all users, including those with visual impairments.
              </p>
            </div>
          </div>
        </section>

        <!-- Accessibility section -->
        <section class="mb-24">
          <div class="flex items-center mb-12">
            <div class="h-px bg-neutral-200 dark:bg-neutral-800 flex-grow"></div>
            <h2 class="text-2xl md:text-3xl font-bold px-8 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 whitespace-nowrap">
              <IconEye className="w-8 h-8 text-blue-500" />
              <span>Accessibility Approach</span>
            </h2>
            <div class="h-px bg-neutral-200 dark:bg-neutral-800 flex-grow"></div>
          </div>
          
          <div class="max-w-3xl mx-auto">
            <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed mb-8">
              A key focus of our design system was ensuring WCAG compliance throughout all components. The previous color palette failed to meet contrast standards, so we used Leonardo Color to systematically address these issues.
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
              <div class="bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl border border-neutral-200 dark:border-neutral-800">
                <h3 class="text-lg font-bold mb-3 text-neutral-800 dark:text-neutral-100">Before</h3>
                <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400">
                  <li>Faded, worn-looking colors</li>
                  <li>Failed WCAG contrast requirements</li>
                  <li>Inconsistent application across UI</li>
                  <li>Didn't reflect community vision</li>
                </ul>
              </div>
              
              <div class="bg-neutral-50 dark:bg-neutral-900 p-6 rounded-xl border border-neutral-200 dark:border-neutral-800">
                <h3 class="text-lg font-bold mb-3 text-neutral-800 dark:text-neutral-100">After</h3>
                <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400">
                  <li>Vibrant, modern palette</li>
                  <li>WCAG AA/AAA compliant contrasts</li>
                  <li>Systematic application across components</li>
                  <li>Aligned with community-driven vision</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- Outcomes section with cards -->
        <section class="mb-24 relative overflow-hidden">
          <div class="absolute -left-20 -bottom-40 w-80 h-80 bg-blue-100 dark:bg-blue-900 rounded-full opacity-30 blur-3xl"></div>
          
          <h2 class="text-2xl md:text-3xl font-bold mb-12 flex items-center gap-3 text-neutral-800 dark:text-neutral-100 relative z-10">
            <IconCheck className="w-8 h-8 text-blue-500" />
            <span>Outcomes</span>
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 relative z-10">
            <div class="bg-white dark:bg-neutral-900 shadow-lg rounded-xl overflow-hidden transform hover:-translate-y-1 transition-transform">
              <div class="h-1 bg-gradient-to-r from-blue-400 to-blue-600"></div>
              <div class="p-6">
                <h3 class="font-bold text-xl mb-3 text-neutral-800 dark:text-neutral-100">Unified Language</h3>
                <p class="text-neutral-600 dark:text-neutral-400">Shared conceptual model and terminology for product components</p>
              </div>
            </div>
            <div class="bg-white dark:bg-neutral-900 shadow-lg rounded-xl overflow-hidden transform hover:-translate-y-1 transition-transform">
              <div class="h-1 bg-gradient-to-r from-green-400 to-green-600"></div>
              <div class="p-6">

---
export const prerender = true;
import { Button } from "@/components/ui/button";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";
import {
  IconBuildingSkyscraper,
  IconSearch,
  IconTarget,
  IconHeartHandshake,
  IconCheck,
  IconExternalLink,
  IconChevronRight,
  IconArrowRight,
  IconBrandWordpress,
  IconFolders,
  IconLayoutDashboard
} from "@tabler/icons-react";
import OptimizedImage from "@/components/optimizedImage.astro";
import "../styles/globals.css";
const meta = {
  title: "Case Study | Cloud First Nordics Knowledge Hub",
  description:
    "Design and development of a centralized knowledge hub for cloud technology, offerings, and events for Accenture's internal employees.",
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    
      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
  </head>

  <body class="bg-white dark:bg-black">
    <FloatingDockDemo client:load />

    <!-- Hero section with overlapping elements -->
    <header class="relative pt-20 pb-0 bg-gradient-to-br from-violet-50 to-neutral-100 dark:from-neutral-950 dark:to-violet-950 overflow-hidden">

---
import { FilesystemItemAnimatedDemo } from "@/components/ui/file-projects";
import { MobileFolderView } from "@/components/ui/mobile-folder-view";
import { LayoutGridDemo as UXUniteDemo } from "@/components/ui/previews/UxUnite-preview";
import { LayoutGridDemo as ArtsyLayoutGridDemo } from "@/components/ui/previews/Artsy-preview";
import { LayoutGridDemo as CloudFirstLayoutGridDemo } from "@/components/ui/previews/CloudFirst-preview";
import { LayoutGridDemo as FireflyLayoutGridDemo } from "@/components/ui/previews/Firefly-preview";
import { LayoutGridDemo as AstraLayoutGridDemo } from "@/components/ui/previews/Astra-preview";
import { LayoutGridDemo as ITWorkshopLayoutGridDemo } from "@/components/ui/previews/IT-preview";
import { LazySection } from "@/components/ui/lazy-section";
---

<section id="works" class="bg-neutral-100 w-full dark:bg-neutral-900 relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 py-8 sm:py-16 flex flex-col">
    <div class="flex items-end">
      <h2 class="text-nowrap text-left text-4xl font-black tracking-tight text-neutral-800 dark: md:text-5xl lg:text-7xl/14 dark:text-neutral-100">Selected Works</h2>
      <hr class="w-full border-t-2 border-black border-neutral-300 dark:border-neutral-700" />
    </div>
    
    <!-- Mobile folder view (more filesystem-like) -->
    <div class="mt-10 block md:hidden">
      <MobileFolderView client:visible />
    </div>
    
    <!-- Desktop filesystem view -->
    <div id="projects" class="relative mt-10 hidden md:flex gap-2 sm:gap-4 md:gap-6 lg:gap-16 h-screen">
      <div id="file-scroller" class="sticky w-2xs top-10">
        <FilesystemItemAnimatedDemo client:visible/>
      </div>
      <div id="gallery" class="w-full rounded-xl h-full relative">
        <LazySection threshold={0.1} rootMargin="200px" client:load>
          <div id="uxunite-case" data-case class="rounded-xl" aria-hidden="true" hidden data-active="false">
            <UXUniteDemo client:visible />
          </div>
          <div id="artsy-case" data-case class="rounded-xl" aria-hidden="true" hidden data-active="false">
            <ArtsyLayoutGridDemo client:visible />
          </div>
          <div id="cloudfirst-case" data-case class="rounded-xl" aria-hidden="true" hidden data-active="false">
            <CloudFirstLayoutGridDemo client:visible />
          </div>
          <div id="firefly-case" data-case class="rounded-xl" aria-hidden="true" hidden data-active="false">
            <FireflyLayoutGridDemo client:visible />
          </div>
          <div id="astra-case" data-case class="rounded-xl" aria-hidden="true" hidden data-active="false">
            <AstraLayoutGridDemo client:visible />
          </div>
          <div id="itworkshop-case" data-case class="rounded-xl" aria-hidden="true" hidden data-active="false">
            <ITWorkshopLayoutGridDemo client:visible />
          </div>
        </LazySection>
      </div>
    </div>
  </div>
</section>
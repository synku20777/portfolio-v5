---
import SiteShell from "@/components/SiteShell.astro";
import { siteConfig } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  readingTime?: string;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], readingTime } = Astro.props;
const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedUpdated = updatedDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const noteSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(heroImage && Astro.site && { image: new URL(heroImage, Astro.site).toString() }),
  author: {
    "@type": "Person",
    name: siteConfig.personName,
    url: siteConfig.siteUrl,
  },
  publisher: {
    "@type": "Person",
    name: siteConfig.personName,
    url: siteConfig.siteUrl,
  },
};
---

<SiteShell
  title={`${title} | Notes by ${siteConfig.name}`}
  description={description}
  image={heroImage ?? siteConfig.defaultImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  updatedTime={updatedDate?.toISOString()}
  tags={tags}
  schema={noteSchema}
  mainClass="bg-white pb-20 pt-8 dark:bg-black sm:pt-12"
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Nest Notes" href="/rss.xml" />
  </Fragment>

  <article class="mx-auto max-w-7xl px-6">
    <a
      href="/blog"
      class="group mb-10 inline-flex min-h-11 items-center gap-2 rounded-full border border-neutral-400 px-4 text-sm font-medium text-neutral-700 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:text-neutral-200 dark:hover:bg-neutral-900 dark:focus-visible:outline-sky-400 sm:mb-14"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="motion-safe:transition-transform motion-safe:group-hover:-translate-x-1">
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      All notes
    </a>

    <header class="notes-reveal mb-12 max-w-[60rem] sm:mb-16">
      <h1 class="max-w-[23ch] text-balance text-4xl font-semibold leading-[1.1] tracking-[-0.04em] text-neutral-900 dark:text-neutral-100 sm:text-5xl lg:text-6xl">
        {title}
      </h1>
      <p class="mt-6 max-w-[52ch] text-balance text-lg leading-relaxed text-neutral-600 dark:text-neutral-300 sm:text-xl">{description}</p>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-5 text-sm leading-relaxed">
        <div>
          <dt class="text-neutral-500 dark:text-neutral-400">Published</dt>
          <dd class="mt-1 text-neutral-900 dark:text-neutral-200"><time datetime={pubDate.toISOString()}>{formattedDate}</time></dd>
        </div>
        {readingTime && (
          <div>
            <dt class="text-neutral-500 dark:text-neutral-400">Reading time</dt>
            <dd class="mt-1 text-neutral-900 dark:text-neutral-200">{readingTime}</dd>
          </div>
        )}
        {updatedDate && (
          <div>
            <dt class="text-neutral-500 dark:text-neutral-400">Updated</dt>
            <dd class="mt-1 text-neutral-900 dark:text-neutral-200"><time datetime={updatedDate.toISOString()}>{formattedUpdated}</time></dd>
          </div>
        )}
      </dl>

      {tags.length > 0 && (
        <nav aria-label="Note topics" class="mt-6 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a href={`/blog/tag/${encodeURIComponent(tag)}`} class="inline-flex min-h-11 items-center rounded-full border border-neutral-400 px-4 text-sm text-neutral-700 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:text-neutral-200 dark:hover:bg-neutral-900 dark:focus-visible:outline-sky-400">
              {tag}
            </a>
          ))}
        </nav>
      )}
    </header>

    {heroImage && (
      <div class="mb-12 max-w-[60rem] overflow-hidden rounded-2xl border border-neutral-200 dark:border-neutral-800">
        <img src={heroImage} alt={title} class="h-auto w-full" loading="eager" decoding="async" />
      </div>
    )}

    <div class="notes-prose prose prose-lg prose-neutral max-w-[68ch] leading-relaxed prose-headings:font-semibold prose-headings:leading-tight prose-headings:tracking-tight prose-a:underline-offset-4 prose-img:rounded-2xl dark:prose-invert">
      <slot />
    </div>
  </article>
</SiteShell>

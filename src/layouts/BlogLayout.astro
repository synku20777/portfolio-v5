---
import BaseHead from "@/components/BaseHead.astro";
import "@/styles/globals.css";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  readingTime?: string;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], readingTime } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedUpdated = updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <BaseHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Nest Blog</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Nest Blog" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {heroImage && <meta property="og:image" content={new URL(heroImage, Astro.site)} />}
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content={heroImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {heroImage && <meta name="twitter:image" content={new URL(heroImage, Astro.site)} />}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "datePublished": pubDate.toISOString(),
      ...(updatedDate && { "dateModified": updatedDate.toISOString() }),
      ...(heroImage && { "image": new URL(heroImage, Astro.site).toString() }),
      "author": {
        "@type": "Person",
        "name": "Nest",
        "url": Astro.site?.toString()
      },
      "publisher": {
        "@type": "Person",
        "name": "Nest"
      }
    })} />

    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const setDarkClass = () => {
        const isDark = getThemePreference() === 'dark';
        document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
      };

      setDarkClass();
      document.addEventListener('astro:after-swap', setDarkClass);

      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
  </head>

  <body class="bg-white dark:bg-black antialiased selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <FloatingDockDemo client:load />

    <main class="pt-20 pb-16">
      <article class="mx-auto max-w-3xl px-6">
        <!-- Back link -->
        <a href="/blog" class="inline-flex items-center gap-2 mb-8 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back to blog
        </a>

        <!-- Article header -->
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-3 mb-4 text-sm text-neutral-500 dark:text-neutral-400">
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {readingTime && (
              <>
                <span aria-hidden="true">·</span>
                <span>{readingTime}</span>
              </>
            )}
          </div>

          <h1 class="text-3xl font-bold leading-tight tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-4xl">
            {title}
          </h1>

          <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
            {description}
          </p>

          {tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {tags.map(tag => (
                <a
                  href={`/blog/tag/${tag}`}
                  class="inline-flex items-center rounded-full border border-neutral-200/80 bg-white px-2.5 py-1 text-xs font-semibold uppercase tracking-tighter text-stone-500 hover:bg-neutral-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 transition-colors"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}

          {updatedDate && (
            <p class="mt-4 text-sm italic text-neutral-500 dark:text-neutral-400">
              Updated on {formattedUpdated}
            </p>
          )}
        </header>

        <!-- Hero image -->
        {heroImage && (
          <div class="mb-10 overflow-hidden rounded-lg">
            <img
              src={heroImage}
              alt={title}
              class="w-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        )}

        <!-- Article content -->
        <div class="prose prose-neutral dark:prose-invert prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:underline-offset-4 prose-img:rounded-lg">
          <slot />
        </div>
      </article>
    </main>

    <Footer name="Nest" client:visible />
  </body>
</html>

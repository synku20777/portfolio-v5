---
import SiteShell from "@/components/SiteShell.astro";
import { siteConfig } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  readingTime?: string;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], readingTime } = Astro.props;
const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedUpdated = updatedDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const noteSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(heroImage && Astro.site && { image: new URL(heroImage, Astro.site).toString() }),
  author: {
    "@type": "Person",
    name: siteConfig.personName,
    url: siteConfig.siteUrl,
  },
  publisher: {
    "@type": "Person",
    name: siteConfig.personName,
    url: siteConfig.siteUrl,
  },
};
---

<SiteShell
  title={`${title} | Notes by ${siteConfig.name}`}
  description={description}
  image={heroImage ?? siteConfig.defaultImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  updatedTime={updatedDate?.toISOString()}
  tags={tags}
  schema={noteSchema}
  mainClass="pt-20 pb-16"
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Nest Notes" href="/rss.xml" />
  </Fragment>

  <article class="mx-auto max-w-3xl px-6">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 mb-8 text-neutral-700 transition-colors hover:text-black dark:text-neutral-300 dark:hover:text-white"
    >
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="inline-block"
      >
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      Back to notes
    </a>

    <header class="mb-10">
      <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-neutral-500 dark:text-neutral-400">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {readingTime && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>{readingTime}</span>
          </>
        )}
      </div>

      <h1 class="text-3xl font-bold leading-tight tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-4xl">
        {title}
      </h1>

      <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">{description}</p>

      {tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/blog/tag/${encodeURIComponent(tag)}`}
              class="inline-flex items-center rounded-full border border-neutral-200/80 bg-white px-2.5 py-1 text-xs font-semibold uppercase tracking-tighter text-stone-500 transition-colors hover:bg-neutral-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      {updatedDate && (
        <p class="mt-4 text-sm italic text-neutral-500 dark:text-neutral-400">
          Updated on {formattedUpdated}
        </p>
      )}
    </header>

    {heroImage && (
      <div class="mb-10 overflow-hidden rounded-lg">
        <img
          src={heroImage}
          alt={title}
          class="w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <div class="prose prose-lg prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:underline-offset-4 prose-img:rounded-lg dark:prose-invert">
      <slot />
    </div>
  </article>
</SiteShell>

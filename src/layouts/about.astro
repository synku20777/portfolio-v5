---
import OptimizedImage from "@/components/optimizedImage.astro";
---

<section id="about" aria-labelledby="about-heading" class="scroll-mt-8 bg-white text-neutral-900 dark:bg-black dark:text-neutral-100">
  <div class="mx-auto max-w-7xl border-t border-neutral-200 px-6 py-16 dark:border-neutral-800 sm:py-24">
    <h2 id="about-heading" class="mb-10 text-4xl font-semibold tracking-tight sm:text-5xl">About me</h2>
    <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <p class="max-w-[38ch] text-balance text-2xl font-semibold leading-snug tracking-tight sm:text-3xl">
          I work where interface design meets code, connecting product structure, visual detail, and reusable systems.
        </p>
        <p class="mt-7 max-w-[52ch] text-base leading-relaxed text-neutral-600 dark:text-neutral-300 sm:text-lg">
          I am drawn to projects that make complex information easier to use. I move between research,
          prototyping, and frontend development, using each to inform the next decision. Outside work,
          I photograph cities and skies and build side projects.
        </p>
      </div>
      <figure class="about-portrait w-56 max-w-full lg:col-span-4 lg:col-start-9 lg:w-full lg:max-w-72">
        <div class="overflow-hidden rounded-2xl border border-neutral-200 dark:border-neutral-800">
          <OptimizedImage
            src={import("../../public/photos/IMGA0704_3.webp")}
            alt="Portrait of Nestor Kulik"
            sizes="(max-width: 1023px) 224px, 288px"
            class="h-auto w-full object-contain grayscale"
          />
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .about-portrait {
        animation: about-portrait-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
    }
  }

  @keyframes about-portrait-settle {
    from { transform: translateY(20px) rotate(2deg); }
    to { transform: translateY(0) rotate(0); }
  }
</style>

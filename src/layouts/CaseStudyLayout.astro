---
import BaseHead from "@/components/BaseHead.astro";
import "@/styles/globals.css";
import Footer from "@/components/ui/footer";
import { FloatingDockDemo } from "@/components/ui/nav-dock";

interface Props {
  title: string;
  description: string;
  category: string;
  role?: string;
  client?: string;
  duration?: string;
  tools?: string;
  year?: string;
  heroImage: string;
  outcomes?: string[];
  tags?: string[];
  themeColor?: string;
}

const {
  title,
  description,
  category,
  role,
  client,
  duration,
  tools,
  year,
  heroImage,
  outcomes = [],
  tags = [],
  themeColor = 'neutral',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const headerGradients: Record<string, string> = {
  neutral: 'from-neutral-50 to-neutral-100 dark:from-neutral-950 dark:to-neutral-950',
  blue: 'from-blue-50 to-neutral-100 dark:from-neutral-950 dark:to-blue-950',
  violet: 'from-violet-50 to-neutral-100 dark:from-neutral-950 dark:to-violet-950',
  amber: 'from-amber-50 to-neutral-100 dark:from-neutral-950 dark:to-amber-950',
  indigo: 'from-indigo-50 to-neutral-100 dark:from-neutral-950 dark:to-indigo-950',
  rose: 'from-rose-50 to-neutral-100 dark:from-neutral-950 dark:to-rose-950',
  emerald: 'from-emerald-50 to-neutral-100 dark:from-neutral-950 dark:to-emerald-950',
  teal: 'from-teal-50 to-neutral-100 dark:from-neutral-950 dark:to-teal-950',
};
---

<html lang="en">
  <head>
    <BaseHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(heroImage, Astro.site)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(heroImage, Astro.site)} />

    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
  </head>

  <body class="bg-white dark:bg-black">
    <a class="skip-link" href="#content" onclick="document.getElementById('content')?.focus()">Skip to content</a>
    <FloatingDockDemo client:load />

    <!-- Hero section -->
    <header class={`relative pt-20 pb-0 bg-gradient-to-br ${headerGradients[themeColor] || headerGradients.neutral} overflow-hidden`}>
      <div class="mx-auto max-w-7xl px-6">
        <a href="/" class="inline-flex items-center gap-2 mb-8 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back
        </a>

        <!-- Project metadata row -->
        <div class="flex flex-wrap gap-6 mb-6 text-sm">
          <div class="inline-block px-3 py-1 font-medium tracking-wider rounded-full bg-neutral-200 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
            {category}
          </div>
          {role && (
            <div class="flex items-center gap-2">
              <span class="font-medium text-neutral-500 dark:text-neutral-400">Role:</span>
              <span class="text-neutral-800 dark:text-neutral-200">{role}</span>
            </div>
          )}
          {client && (
            <div class="flex items-center gap-2">
              <span class="font-medium text-neutral-500 dark:text-neutral-400">Client:</span>
              <span class="text-neutral-800 dark:text-neutral-200">{client}</span>
            </div>
          )}
          {duration && (
            <div class="flex items-center gap-2">
              <span class="font-medium text-neutral-500 dark:text-neutral-400">Duration:</span>
              <span class="text-neutral-800 dark:text-neutral-200">{duration}</span>
            </div>
          )}
          {tools && (
            <div class="flex items-center gap-2">
              <span class="font-medium text-neutral-500 dark:text-neutral-400">Tools:</span>
              <span class="text-neutral-800 dark:text-neutral-200">{tools}</span>
            </div>
          )}
          {year && (
            <div class="flex items-center gap-2">
              <span class="font-medium text-neutral-500 dark:text-neutral-400">Year:</span>
              <span class="text-neutral-800 dark:text-neutral-200">{year}</span>
            </div>
          )}
        </div>

        <!-- Main heading -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="relative z-10">
            <div class="absolute -left-10 -top-10 w-32 h-32 bg-neutral-100 dark:bg-neutral-900 rounded-full opacity-50 blur-2xl"></div>
            <h1 class="relative text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-neutral-800 dark:text-neutral-100 mb-6">
              {title}
            </h1>
            <p class="text-lg md:text-xl text-neutral-700 dark:text-neutral-300 max-w-xl mb-10">
              {description}
            </p>

            {outcomes.length > 0 && (
              <div class="flex flex-wrap gap-4 mb-10">
                {outcomes.map((outcome) => (
                  <div class="py-2 px-4 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm text-neutral-800 dark:text-neutral-200 text-sm font-medium shadow-sm">
                    {outcome}
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="relative">
            <div class="absolute -right-40 -bottom-20 w-80 h-80 bg-neutral-200 dark:bg-neutral-800 rounded-full opacity-30 blur-3xl"></div>
            <div class="absolute right-20 top-10 w-32 h-32 bg-neutral-200 dark:bg-neutral-900 rounded-full opacity-30 blur-xl"></div>
            <div class="w-full rounded-xl overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
              <img
                src={heroImage}
                alt={`${title} hero image`}
                class="w-full h-full object-cover"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="flex justify-center mt-8 mb-4">
          <a href="#content" class="animate-bounce p-2 rounded-full bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm shadow-sm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-500 dark:text-neutral-400 rotate-90">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main id="content" class="case-study-content py-24 bg-white dark:bg-black" tabindex="-1">
      <div class="mx-auto max-w-7xl px-6">
        <slot />
      </div>
    </main>

    <style is:global>
      .case-study-content p {
        color: var(--color-neutral-600);
      }
      :root.dark .case-study-content p {
        color: var(--color-neutral-400);
      }
    </style>

    <Footer name="Nest" client:load />
  </body>
</html>

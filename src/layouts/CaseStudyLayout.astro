---
import SiteShell from "@/components/SiteShell.astro";
import { siteConfig } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  category: string;
  role?: string;
  client?: string;
  duration?: string;
  tools?: string;
  year?: string;
  heroImage: string;
  outcomes?: string[];
  tags?: string[];
  themeColor?: string;
  constraint?: string;
  keyDecision?: string;
  result?: string;
}

const {
  title,
  description,
  category,
  role,
  client,
  duration,
  tools,
  year,
  heroImage,
  outcomes = [],
  tags = [],
  themeColor = "neutral",
  constraint,
  keyDecision,
  result,
} = Astro.props;

const headerGradients: Record<string, string> = {
  neutral: "from-neutral-50 to-neutral-100 dark:from-neutral-950 dark:to-neutral-950",
  blue: "from-blue-50 to-neutral-100 dark:from-neutral-950 dark:to-blue-950",
  violet: "from-violet-50 to-neutral-100 dark:from-neutral-950 dark:to-violet-950",
  amber: "from-amber-50 to-neutral-100 dark:from-neutral-950 dark:to-amber-950",
  indigo: "from-indigo-50 to-neutral-100 dark:from-neutral-950 dark:to-indigo-950",
  rose: "from-rose-50 to-neutral-100 dark:from-neutral-950 dark:to-rose-950",
  emerald: "from-emerald-50 to-neutral-100 dark:from-neutral-950 dark:to-emerald-950",
  teal: "from-teal-50 to-neutral-100 dark:from-neutral-950 dark:to-teal-950",
};

const signalCards = [
  {
    label: "What I did",
    value: role ? `${role}${tools ? ` using ${tools}` : ""}` : tools,
  },
  { label: "Constraint", value: constraint },
  { label: "Key decision", value: keyDecision },
  {
    label: "What changed",
    value: result ?? (outcomes.length > 0 ? outcomes.join(" / ") : undefined),
  },
].filter((item): item is { label: string; value: string } => Boolean(item.value));

const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  headline: title,
  description,
  genre: category,
  ...(Astro.site && { image: new URL(heroImage, Astro.site).toString() }),
  author: {
    "@type": "Person",
    name: siteConfig.personName,
    url: siteConfig.siteUrl,
  },
  creator: {
    "@type": "Person",
    name: siteConfig.personName,
    url: siteConfig.siteUrl,
  },
  keywords: tags,
};
---

<SiteShell
  title={`${title} | ${siteConfig.name}`}
  description={description}
  image={heroImage}
  type="article"
  tags={tags}
  schema={caseStudySchema}
>
  <header
    class={`relative overflow-hidden bg-gradient-to-br pb-0 pt-20 ${headerGradients[themeColor] || headerGradients.neutral}`}
  >
    <div class="mx-auto max-w-7xl px-6">
      <a
        href="/"
        class="mb-8 inline-flex items-center gap-2 text-neutral-700 transition-colors hover:text-black dark:text-neutral-300 dark:hover:text-white"
      >
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="inline-block"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back
      </a>

      <div class="mb-6 flex flex-wrap gap-6 text-sm">
        <div class="inline-block rounded-full bg-neutral-200 px-3 py-1 font-medium tracking-wider text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
          {category}
        </div>
        {client && (
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Client:</span>
            <span class="text-neutral-800 dark:text-neutral-200">{client}</span>
          </div>
        )}
        {duration && (
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Duration:</span>
            <span class="text-neutral-800 dark:text-neutral-200">{duration}</span>
          </div>
        )}
        {year && (
          <div class="flex items-center gap-2">
            <span class="font-medium text-neutral-500 dark:text-neutral-400">Year:</span>
            <span class="text-neutral-800 dark:text-neutral-200">{year}</span>
          </div>
        )}
      </div>

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div class="relative z-10">
          <div class="absolute -left-10 -top-10 h-32 w-32 rounded-full bg-neutral-100 opacity-50 blur-2xl dark:bg-neutral-900"></div>
          <h1 class="relative mb-6 text-4xl font-black tracking-tight text-neutral-800 dark:text-neutral-100 md:text-5xl lg:text-6xl">
            {title}
          </h1>
          <p class="mb-8 max-w-xl text-lg text-neutral-700 dark:text-neutral-300 md:text-xl">{description}</p>

          {outcomes.length > 0 && (
            <div class="mb-6 flex flex-wrap gap-4">
              {outcomes.map((outcome) => (
                <div class="rounded-full bg-white/80 px-4 py-2 text-sm font-medium text-neutral-800 shadow-sm backdrop-blur-sm dark:bg-neutral-800/80 dark:text-neutral-200">
                  {outcome}
                </div>
              ))}
            </div>
          )}

          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full border border-neutral-200/80 bg-white px-2.5 py-1 text-xs font-semibold uppercase tracking-tighter text-stone-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <div class="relative">
          <div class="absolute -bottom-20 -right-40 h-80 w-80 rounded-full bg-neutral-200 opacity-30 blur-3xl dark:bg-neutral-800"></div>
          <div class="absolute right-20 top-10 h-32 w-32 rounded-full bg-neutral-200 opacity-30 blur-xl dark:bg-neutral-900"></div>
          <div class="w-full overflow-hidden rounded-xl shadow-2xl transition-transform duration-500 hover:rotate-0 lg:rotate-2">
            <img
              src={heroImage}
              alt={`${title} hero image`}
              class="h-full w-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <div class="mb-4 mt-8 flex justify-center">
        <a href="#case-study" class="rounded-full bg-white/80 p-2 shadow-sm backdrop-blur-sm dark:bg-neutral-800/80">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="rotate-90 text-neutral-500 dark:text-neutral-400"
          >
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <section id="case-study" class="bg-white py-20 dark:bg-black">
    <div class="mx-auto max-w-7xl px-6">
      {signalCards.length > 0 && (
        <div class="mb-16 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {signalCards.map((card) => (
            <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-950">
              <p class="text-xs font-semibold uppercase tracking-[0.3rem] text-neutral-400 dark:text-neutral-500">
                {card.label}
              </p>
              <p class="mt-3 text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
                {card.value}
              </p>
            </div>
          ))}
        </div>
      )}

      <div class="case-study-content">
        <slot />
      </div>
    </div>
  </section>

  <style is:global>
    .case-study-content p {
      color: var(--color-neutral-600);
    }

    :root.dark .case-study-content p {
      color: var(--color-neutral-400);
    }
  </style>
</SiteShell>

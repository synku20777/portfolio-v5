---
/**
 * Static Astro page replicating the structure of the uploaded case‑study page.
 * Save as: src/pages/case-study.astro
 * Prerenders to HTML, no JS needed. Pure CSS (no Tailwind).
 *
 * Replace copy and image sources as you wish.
 */
export const prerender = true;
const meta = {
  title: "Case study",
  description:
    "A case study page with hero, two‑column layout, process, research, priorities, outcomes, and a CTA sidebar.",
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
  </head>

  <body>
    <header class="header">
      <div class="container">
        <a class="back" href="/">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
          Back
        </a>
        <div>
          <span class="badge">Mobile Design</span>
          <h1 class="title">In‑App Navigation Experience for Professional Truck Drivers</h1>
          <p class="lead">Designed and shipped a native, turn‑by‑turn navigation feature that removed dependency on third‑party apps and delivered seamless offline routing for professional truck drivers across Europe.</p>
        </div>
        <div class="hero" role="img" aria-label="Hero image showing the navigation app UI">
          <img src="/images/case-study-hero.jpg" alt="In‑app navigation hero image" />
        </div>
      </div>
    </header>

    <main class="page">
      <div class="container grid">
        <!-- Main column -->
        <div>
          <section class="section">
            <h2>The Challenge</h2>
            <p class="muted">Professional truck drivers needed integrated navigation with offline maps, truck‑specific constraints, platform‑native patterns for iOS and Android, and safe use in low‑distraction contexts — especially at night.</p>
          </section>

          <section class="section">
            <h2>The Solution</h2>
            <p class="muted">We scoped an MVP on a robust mapping SDK, prioritizing current location, route search & preview, offline map management, and core navigation states. The UI favors glanceability with high contrast, dark mode support, and progressive disclosure.</p>
          </section>

          <section class="section">
            <h2>Design Process</h2>
            <div class="process" role="list">
              <div class="step" role="listitem"><span class="num">1</span><span>Problem definition & technical foundation planning</span></div>
              <div class="step" role="listitem"><span class="num">2</span><span>User research with driver personas</span></div>
              <div class="step" role="listitem"><span class="num">3</span><span>Task‑based usability testing</span></div>
              <div class="step" role="listitem"><span class="num">4</span><span>Think‑aloud reviews with interactive prototypes</span></div>
              <div class="step" role="listitem"><span class="num">5</span><span>Field testing during live driving scenarios</span></div>
              <div class="step" role="listitem"><span class="num">6</span><span>Cognitive walkthroughs for low‑distraction use</span></div>
              <div class="step" role="listitem"><span class="num">7</span><span>Close collaboration with mobile engineering</span></div>
              <div class="step" role="listitem"><span class="num">8</span><span>QA support with prototype‑based regression tests</span></div>
            </div>
          </section>

          <section class="section">
            <h2>🏗️ Technical Foundation & Constraints</h2>
            <p class="muted">Built on a commercial maps SDK offering routing, search, and offline capabilities. We intentionally adopted platform‑native interaction models and deferred advanced features to post‑MVP phases.</p>
            <ul class="muted" style="padding-left: 20px; margin: 12px 0;">
              <li>Current location handling</li>
              <li>Route search & preview</li>
              <li>Offline map downloads</li>
              <li>Core navigation UI states</li>
            </ul>
          </section>

          <section class="section">
            <h2>🔍 Research Approach</h2>
            <div class="pill-list">
              <div class="pill"><span class="dot"></span><div><strong>Task‑based usability testing</strong><div class="muted" style="font-size:14px">With internal & external driver personas</div></div></div>
              <div class="pill"><span class="dot"></span><div><strong>Think‑aloud protocol</strong><div class="muted" style="font-size:14px">Interactive prototype reviews</div></div></div>
              <div class="pill"><span class="dot"></span><div><strong>Field testing</strong><div class="muted" style="font-size:14px">On devices in live driving scenarios</div></div></div>
              <div class="pill"><span class="dot"></span><div><strong>Cognitive walkthroughs</strong><div class="muted" style="font-size:14px">Ensuring intuitive, low‑distraction flows</div></div></div>
            </div>
          </section>

          <section class="section">
            <h2>🎯 UX Design Priorities</h2>
            <div class="pill-list">
              <div class="pill">
                <span class="dot"></span>
                <div><strong>Glanceability</strong><div class="muted" style="font-size:14px">Large, high‑contrast visuals & generous targets</div></div>
              </div>
              <div class="pill">
                <span class="dot"></span>
                <div><strong>Dark mode support</strong><div class="muted" style="font-size:14px">Critical for nighttime safety</div></div>
              </div>
              <div class="pill">
                <span class="dot"></span>
                <div><strong>Progressive disclosure</strong><div class="muted" style="font-size:14px">Reduce cognitive load via collapsible UI</div></div>
              </div>
              <div class="pill">
                <span class="dot"></span>
                <div><strong>Fail‑safe offline behavior</strong><div class="muted" style="font-size:14px">Fallback states when maps or routing are unavailable</div></div>
              </div>
            </div>
          </section>

          <section class="section">
            <h2>🤝 Collaboration & Handoff</h2>
            <p class="muted">Worked closely with mobile engineering on feasibility, transitions, and performance. Supported QA with prototype‑based regression flows and delivered state‑aware design specs with component documentation.</p>
          </section>

          <section class="section">
            <h2>✅ Outcomes</h2>
            <div class="stat-grid">
              <div class="card stat"><div class="inner"><div class="value">Eliminated</div><div class="label">External App Dependency</div></div></div>
              <div class="card stat"><div class="inner"><div class="value">Multiple Clients</div><div class="label">Fleet Adoption</div></div></div>
              <div class="card stat"><div class="inner"><div class="value">Enhanced</div><div class="label">User Experience</div></div></div>
            </div>
            <p class="muted" style="margin-top: 12px;">Shipped within scope and adopted by target users, laying the foundation for lane guidance, POI enhancements, and truck‑aware route adjustments.</p>
          </section>

          <section class="section">
            <h2>📹 MVP Development Process</h2>
            <p class="muted">A short clip showing iterative design & testing during the MVP phase.</p>
            <div class="video-wrap" aria-label="MVP process video">
              <!-- Replace the src with your own video or YouTube embed URL -->
              <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="MVP Development Process" allowfullscreen loading="lazy"></iframe>
            </div>
          </section>
        </div>

        <!-- Sidebar column -->
        <aside class="sidebar" aria-label="Project sidebar">
          <div class="card">
            <div class="inner">
              <h3 style="margin:0 0 12px; font-size:20px;">Project Details</h3>
              <div style="display:grid; gap:14px;">
                <div><div class="label">Client</div><div class="value">Your Client</div></div>
                <div><div class="label">Duration</div><div class="value">2 months</div></div>
                <div><div class="label">Team</div><div class="value">Product Team, Mobile Engineering</div></div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="inner">
              <h3 style="margin:0 0 12px; font-size:20px;">Interested in similar work?</h3>
              <p class="muted" style="font-size:14px; margin: 0 0 12px;">Let's discuss how I can help with your product.</p>
              <a class="btn" href="mailto:hello@example.com">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                Start a Project
              </a>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <footer class="footer">
      <div class="container">© {new Date().getFullYear()} Your Name</div>
    </footer>
  </body>
</html>

---
import { Image } from 'astro:assets';

const { src, alt, widths = [400, 800, 1200], sizes, class: className } = Astro.props;
---

<Image 
  src={src} 
  alt={alt} 
  widths={widths}
  sizes={sizes || "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"}
  format="avif"
  class={className}
/>
---
import { siteConfig } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  canonical,
  image = siteConfig.defaultImage,
  type = "website",
  publishedTime,
  updatedTime,
  tags = [],
  schema,
} = Astro.props;

const resolvedCanonical = (() => {
  if (canonical) {
    return new URL(canonical, Astro.site).toString();
  }
  return Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
})();

const resolvedImage = image && Astro.site ? new URL(image, Astro.site).toString() : undefined;
const schemaPayload = schema
  ? JSON.stringify(Array.isArray(schema) ? schema : [schema])
  : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta name="twitter:card" content={resolvedImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{resolvedCanonical && (
  <>
    <link rel="canonical" href={resolvedCanonical} />
    <meta property="og:url" content={resolvedCanonical} />
  </>
)}
{resolvedImage && (
  <>
    <meta property="og:image" content={resolvedImage} />
    <meta name="twitter:image" content={resolvedImage} />
  </>
)}
{type === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === "article" && updatedTime && (
  <meta property="article:modified_time" content={updatedTime} />
)}
{type === "article" &&
  tags.map((tag) => <meta property="article:tag" content={tag} />)}
<link
  rel="preload"
  href="/font/plus-jakarta-sans-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
{schemaPayload && <script type="application/ld+json" set:html={schemaPayload} />}

<style is:inline>
  @font-face {
    font-family: "Jakarta";
    src: url('/font/plus-jakarta-sans-latin.woff2') format('woff2');
    font-weight: 200 800;
    font-display: swap;
    font-style: normal;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Jakarta";
    src: url('/font/plus-jakarta-sans-latin-ext.woff2') format('woff2');
    font-weight: 200 800;
    font-display: swap;
    font-style: normal;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
</style>

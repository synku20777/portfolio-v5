---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/ui/footer";
import PrimaryDock from "@/components/ui/PrimaryDock.astro";
import { siteConfig } from "@/lib/site";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  mainClass?: string;
  mainId?: string;
  footerName?: string;
  showFooter?: boolean;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  canonical,
  image = siteConfig.defaultImage,
  type = "website",
  publishedTime,
  updatedTime,
  tags = [],
  schema,
  bodyClass = "",
  mainClass = "",
  mainId = "content",
  footerName = siteConfig.name,
  showFooter = true,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      tags={tags}
      schema={schema}
    />
    <slot name="head" />

    <script is:inline>
      (() => {
        const storageKey = "theme";
        const root = document.documentElement;

        const getThemePreference = () => {
          try {
            const storedTheme = localStorage.getItem(storageKey);
            if (storedTheme === "light" || storedTheme === "dark") {
              return storedTheme;
            }
          } catch {}

          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        };

        const applyTheme = () => {
          root.classList.toggle("dark", getThemePreference() === "dark");
        };

        applyTheme();

        if (!window.__nestThemeInitialized) {
          window.__nestThemeInitialized = true;
          document.addEventListener("astro:after-swap", applyTheme);

          try {
            const observer = new MutationObserver(() => {
              localStorage.setItem(
                storageKey,
                root.classList.contains("dark") ? "dark" : "light",
              );
            });

            observer.observe(root, {
              attributes: true,
              attributeFilter: ["class"],
            });
          } catch {}
        }
      })();
    </script>

  </head>

  <body
    class={`bg-white antialiased selection:bg-neutral-200 dark:bg-black dark:selection:bg-neutral-800 ${bodyClass}`.trim()}
  >
    <a class="skip-link" href={`#${mainId}`} onclick={`document.getElementById('${mainId}')?.focus()`}>
      Skip to content
    </a>
    <PrimaryDock />
    <main id={mainId} class={mainClass} tabindex="-1">
      <slot />
    </main>
    {showFooter && <Footer name={footerName} client:visible />}
  </body>
</html>
